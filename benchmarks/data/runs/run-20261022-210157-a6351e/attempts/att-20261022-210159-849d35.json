  "extractedSource": "<section aria-labelledby=\"title\">\n  <h1 id=\"title\">Todo list</h1>\n  <form id=\"add-task\">\n    <label for=\"new-task\">New task</label>\n    <div style=\"display:flex;gap:0.5rem\">\n      <input id=\"new-task\" autocomplete=\"off\" placeholder=\"What needs doing?\">\n      <button type=\"submit\">Add</button>\n    </div>\n  </form>\n  <label for=\"filter\">Show</label>\n  <select id=\"filter\">\n    <option>All</option>\n    <option>Active</option>\n    <option>Done</option>\n  </select>\n  <p id=\"counter\" aria-live=\"polite\"></p>\n  <div id=\"tasks\"></div>\n</section>\n<script>\n(() => {\n  let tasks = [\n    {id:1,text:\"Buy milk\",done:false},\n    {id:2,text:\"Write report\",done:true},\n    {id:3,text:\"Call Alice\",done:false}\n  ], nextId = 4;\n  const input = document.getElementById(\"new-task\");\n  const filter = document.getElementById(\"filter\");\n  const list = document.getElementById(\"tasks\");\n  function render() {\n    const left = tasks.filter(t => !t.done).length;\n    document.getElementById(\"counter\").textContent =\n      `${left.toLocaleString()} ${left === 1 ? \"item\" : \"items\"} left`;\n    list.replaceChildren();\n    tasks.filter(t => filter.value === \"All\" ||\n      (filter.value === \"Done\" ? t.done : !t.done)).forEach(t => {\n      const row = document.createElement(\"article\");\n      row.style.cssText = \"display:flex;align-items:center;justify-content:space-between;gap:1rem\";\n      const label = document.createElement(\"label\");\n      const check = document.createElement(\"input\");\n      check.type = \"checkbox\";\n      check.checked = t.done;\n      check.addEventListener(\"change\", () => { t.done = check.checked; render(); });\n      const text = document.createElement(t.done ? \"s\" : \"span\");\n      text.textContent = t.text;\n      label.append(check, \" \", text);\n      const remove = document.createElement(\"button\");\n      remove.type = \"button\";\n      remove.textContent = \"Delete\";\n      remove.setAttribute(\"aria-label\", \"Delete \" + t.text);\n      remove.addEventListener(\"click\", () => {\n        tasks = tasks.filter(task => task.id !== t.id);\n        render();\n      });\n      row.append(label, remove);\n      list.append(row);\n    });\n  }\n  document.getElementById(\"add-task\").addEventListener(\"submit\", e => {\n    e.preventDefault();\n    const text = input.value.trim();\n    if (!text) return;\n    tasks.push({id:nextId++,text,done:false});\n    input.value = \"\";\n    render();\n    input.focus();\n  });\n  filter.addEventListener(\"input\", render);\n  render();\n})();\n</script>",
