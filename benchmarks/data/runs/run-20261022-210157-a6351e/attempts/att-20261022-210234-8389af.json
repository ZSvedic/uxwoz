  "extractedSource": "<section aria-label=\"Todo list\">\n  <h1>Todo list</h1>\n  <form id=\"add-form\">\n    <label for=\"new-task\">New task</label>\n    <div style=\"display:flex;gap:0.5rem\">\n      <input id=\"new-task\" type=\"text\" autocomplete=\"off\">\n      <button type=\"submit\">Add</button>\n    </div>\n  </form>\n  <label for=\"filter\">Filter</label>\n  <select id=\"filter\">\n    <option>All</option>\n    <option>Active</option>\n    <option>Done</option>\n  </select>\n  <p id=\"counter\" aria-live=\"polite\"></p>\n  <ul id=\"tasks\" style=\"padding:0;list-style:none\"></ul>\n</section>\n<script>\n(() => {\n  let tasks = [\n    {id:1,text:\"Buy milk\",done:false},\n    {id:2,text:\"Write report\",done:true},\n    {id:3,text:\"Call Alice\",done:false}\n  ], nextId = 4;\n  const form = document.getElementById(\"add-form\"),\n    input = document.getElementById(\"new-task\"),\n    filter = document.getElementById(\"filter\"),\n    list = document.getElementById(\"tasks\"),\n    counter = document.getElementById(\"counter\");\n  function render() {\n    const left = tasks.filter(t => !t.done).length;\n    counter.textContent = `${left.toLocaleString()} ${left === 1 ? \"item\" : \"items\"} left`;\n    list.replaceChildren();\n    tasks.filter(t => filter.value === \"All\" || (filter.value === \"Done\" ? t.done : !t.done)).forEach(t => {\n      const row = document.createElement(\"li\"),\n        label = document.createElement(\"label\"),\n        box = document.createElement(\"input\"),\n        text = document.createElement(t.done ? \"s\" : \"span\"),\n        del = document.createElement(\"button\");\n      row.style.cssText = \"display:flex;align-items:center;justify-content:space-between;gap:1rem\";\n      box.type = \"checkbox\";\n      box.checked = t.done;\n      box.addEventListener(\"change\", () => { t.done = box.checked; render(); });\n      text.textContent = t.text;\n      label.append(box, document.createTextNode(\" \"), text);\n      del.type = \"button\";\n      del.textContent = \"Delete\";\n      del.setAttribute(\"aria-label\", \"Delete \" + t.text);\n      del.addEventListener(\"click\", () => { tasks = tasks.filter(x => x.id !== t.id); render(); });\n      row.append(label, del);\n      list.append(row);\n    });\n  }\n  form.addEventListener(\"submit\", e => {\n    e.preventDefault();\n    const text = input.value.trim();\n    if (!text) return;\n    tasks.push({id:nextId++,text,done:false});\n    input.value = \"\";\n    render();\n    input.focus();\n  });\n  filter.addEventListener(\"input\", render);\n  render();\n})();\n</script>",
