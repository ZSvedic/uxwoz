  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 580px; margin: 0 auto;\">\n  <header>\n    <h1 id=\"bmi-title\">BMI calculator</h1>\n    <p>Enter your measurements to check your body mass index.</p>\n  </header>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;\">\n      <label for=\"height\">Height <small>(cm)</small>\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"0.1\" value=\"175\" inputmode=\"decimal\" required>\n      </label>\n      <label for=\"weight\">Weight <small>(kg)</small>\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"0.1\" value=\"70\" inputmode=\"decimal\" required>\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><output id=\"bmi\" for=\"height weight\">22.9</output> <small id=\"category\">Normal</small></h2>\n      <p id=\"feedback\" hidden>Please enter a valid, positive height and weight.</p>\n    </div>\n\n    <svg viewBox=\"0 0 480 115\" width=\"100%\" role=\"img\" aria-labelledby=\"scale-title scale-description\">\n      <title id=\"scale-title\">BMI category scale</title>\n      <desc id=\"scale-description\">BMI 22.9, Normal. Scale displayed from 10 to 40.</desc>\n      <rect x=\"20\" y=\"32\" width=\"124.67\" height=\"18\" rx=\"3\" fill=\"#6baed6\"></rect>\n      <rect x=\"144.67\" y=\"32\" width=\"95.33\" height=\"18\" fill=\"#54a779\"></rect>\n      <rect x=\"240\" y=\"32\" width=\"73.33\" height=\"18\" fill=\"#e9b44c\"></rect>\n      <rect x=\"313.33\" y=\"32\" width=\"146.67\" height=\"18\" rx=\"3\" fill=\"#d77770\"></rect>\n      <g fill=\"currentColor\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\">\n        <text x=\"82\" y=\"74\">Underweight</text>\n        <text x=\"192\" y=\"74\">Normal</text>\n        <text x=\"277\" y=\"74\">Overweight</text>\n        <text x=\"387\" y=\"74\">Obese</text>\n        <text x=\"144.67\" y=\"97\">18.5</text>\n        <text x=\"240\" y=\"97\">25</text>\n        <text x=\"313.33\" y=\"97\">30</text>\n      </g>\n      <g id=\"marker\" transform=\"translate(209,0)\" fill=\"currentColor\">\n        <path d=\"M -6 19 L 6 19 L 0 28 Z\"></path>\n        <text id=\"marker-label\" x=\"0\" y=\"13\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"12\" font-weight=\"bold\">22.9</text>\n      </g>\n    </svg>\n    <small>Adult reference ranges. BMI is a screening tool, not a diagnosis; it does not distinguish muscle from body fat.</small>\n  </article>\n</section>\n\n<script>\n(() => {\n  const height = document.getElementById('height');\n  const weight = document.getElementById('weight');\n  const bmiOutput = document.getElementById('bmi');\n  const category = document.getElementById('category');\n  const feedback = document.getElementById('feedback');\n  const marker = document.getElementById('marker');\n  const markerLabel = document.getElementById('marker-label');\n  const description = document.getElementById('scale-description');\n\n  function update() {\n    const h = height.valueAsNumber;\n    const w = weight.valueAsNumber;\n    const bmi = w / ((h / 100) ** 2);\n    const valid = Number.isFinite(h) && Number.isFinite(w) && h > 0 && w > 0 && Number.isFinite(bmi);\n    feedback.hidden = valid;\n    marker.setAttribute('visibility', valid ? 'visible' : 'hidden');\n    if (!valid) {\n      bmiOutput.textContent = '\u2014';\n      category.textContent = '';\n      description.textContent = 'Enter valid measurements to display your BMI on the category scale.';\n      return;\n    }\n    const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    const classification = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n    bmiOutput.textContent = formatted;\n    category.textContent = classification;\n    markerLabel.textContent = formatted;\n    const clamped = Math.max(10, Math.min(40, bmi));\n    marker.setAttribute('transform', `translate(${20 + (clamped - 10) / 30 * 440},0)`);\n    description.textContent = `BMI ${formatted}, ${classification}. Scale displayed from 10 to 40.${bmi < 10 || bmi > 40 ? ' Marker shown at the nearest scale edge.' : ''}`;\n  }\n  height.addEventListener('input', update);\n  weight.addEventListener('input', update);\n  update();\n})();\n</script>",
