  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 560px; margin: 0 auto;\">\n  <h1 id=\"bmi-title\">BMI calculator</h1>\n  <p>Enter your measurements for a quick body mass index estimate.</p>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;\">\n      <label for=\"height\">Height <small>(cm)</small>\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"any\" value=\"175\" inputmode=\"decimal\">\n      </label>\n      <label for=\"weight\">Weight <small>(kg)</small>\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"any\" value=\"70\" inputmode=\"decimal\">\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><output id=\"bmi\">22.9</output> \u00b7 <span id=\"category\">Normal</span></h2>\n      <p id=\"message\" hidden>Please enter a valid height and weight greater than zero.</p>\n    </div>\n\n    <svg viewBox=\"0 0 440 92\" role=\"img\" aria-labelledby=\"scale-title scale-description\" style=\"width: 100%; height: auto;\">\n      <title id=\"scale-title\">BMI category scale</title>\n      <desc id=\"scale-description\">BMI 22.9, Normal. Scale displays BMI 10 to 40.</desc>\n      <rect x=\"10\" y=\"30\" width=\"119\" height=\"16\" rx=\"3\" fill=\"#60a5fa\"></rect>\n      <rect x=\"129\" y=\"30\" width=\"91\" height=\"16\" fill=\"#34d399\"></rect>\n      <rect x=\"220\" y=\"30\" width=\"70\" height=\"16\" fill=\"#fbbf24\"></rect>\n      <rect x=\"290\" y=\"30\" width=\"140\" height=\"16\" rx=\"3\" fill=\"#f87171\"></rect>\n      <path id=\"pointer\" d=\"M 190 25 L 184 15 L 196 15 Z\" fill=\"currentColor\"></path>\n      <g fill=\"currentColor\" font-size=\"11\" text-anchor=\"middle\">\n        <text x=\"69\" y=\"66\">Underweight</text>\n        <text x=\"174\" y=\"66\">Normal</text>\n        <text x=\"255\" y=\"66\">Overweight</text>\n        <text x=\"360\" y=\"66\">Obese</text>\n        <text x=\"129\" y=\"86\">18.5</text>\n        <text x=\"220\" y=\"86\">25</text>\n        <text x=\"290\" y=\"86\">30</text>\n      </g>\n    </svg>\n    <small>Scale shown: BMI 10\u201340. Values outside this range appear at the nearest edge.</small>\n  </article>\n\n  <p><small>BMI = weight (kg) \u00f7 height (m)\u00b2. Adult BMI is a screening estimate, not a diagnosis; it does not account for muscle mass, pregnancy, or individual health factors.</small></p>\n</section>\n\n<script>\n  (() => {\n    const height = document.getElementById('height');\n    const weight = document.getElementById('weight');\n    const result = document.getElementById('bmi');\n    const category = document.getElementById('category');\n    const message = document.getElementById('message');\n    const pointer = document.getElementById('pointer');\n    const description = document.getElementById('scale-description');\n\n    function update() {\n      const h = height.valueAsNumber;\n      const w = weight.valueAsNumber;\n      const bmi = w / ((h / 100) ** 2);\n      const valid = Number.isFinite(h) && Number.isFinite(w) && h > 0 && w > 0 && Number.isFinite(bmi);\n      message.hidden = valid;\n      pointer.hidden = !valid;\n      pointer.setAttribute('visibility', valid ? 'visible' : 'hidden');\n      if (!valid) {\n        result.textContent = '\u2014';\n        category.textContent = 'Enter measurements';\n        description.textContent = 'No valid BMI to display. Scale displays BMI 10 to 40.';\n        return;\n      }\n      const label = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n      const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n      result.textContent = formatted;\n      category.textContent = label;\n      const x = 10 + (Math.max(10, Math.min(40, bmi)) - 10) * 14;\n      pointer.setAttribute('d', `M ${x} 25 L ${x - 6} 15 L ${x + 6} 15 Z`);\n      description.textContent = `BMI ${formatted}, ${label}. Scale displays BMI 10 to 40.`;\n    }\n\n    height.addEventListener('input', update);\n    weight.addEventListener('input', update);\n    update();\n  })();\n</script>",
