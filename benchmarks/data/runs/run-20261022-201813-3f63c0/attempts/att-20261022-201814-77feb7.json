  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 560px; margin: 2rem auto;\">\n  <header>\n    <h1 id=\"bmi-title\">BMI calculator</h1>\n    <p>Enter your measurements for a quick body mass index estimate.</p>\n  </header>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem;\">\n      <label for=\"height\">Height (cm)\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"any\" value=\"175\" inputmode=\"decimal\">\n      </label>\n      <label for=\"weight\">Weight (kg)\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"any\" value=\"70\" inputmode=\"decimal\">\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><span id=\"bmi-value\">22.9</span> <small id=\"bmi-category\">Normal</small></h2>\n      <p id=\"bmi-message\" hidden>Please enter a valid height and weight greater than zero.</p>\n    </div>\n\n    <figure style=\"margin: 1rem 0;\">\n      <svg viewBox=\"0 0 460 100\" width=\"100%\" role=\"img\" aria-labelledby=\"scale-title scale-description\">\n        <title id=\"scale-title\">BMI category scale</title>\n        <desc id=\"scale-description\">Your BMI is 22.9, in the Normal range. The scale shows BMI values from 10 to 40.</desc>\n        <rect x=\"10\" y=\"28\" width=\"124.67\" height=\"18\" rx=\"3\" fill=\"#72b7db\"/>\n        <rect x=\"134.67\" y=\"28\" width=\"95.33\" height=\"18\" fill=\"#72bc91\"/>\n        <rect x=\"230\" y=\"28\" width=\"73.33\" height=\"18\" fill=\"#e8bd65\"/>\n        <rect x=\"303.33\" y=\"28\" width=\"146.67\" height=\"18\" rx=\"3\" fill=\"#d98880\"/>\n        <g fill=\"currentColor\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\">\n          <text x=\"72\" y=\"68\">Underweight</text>\n          <text x=\"182\" y=\"68\">Normal</text>\n          <text x=\"267\" y=\"68\">Overweight</text>\n          <text x=\"377\" y=\"68\">Obese</text>\n          <text x=\"134.67\" y=\"91\">18.5</text>\n          <text x=\"230\" y=\"91\">25</text>\n          <text x=\"303.33\" y=\"91\">30</text>\n        </g>\n        <path id=\"bmi-pointer\" d=\"M -7 0 L 7 0 L 0 11 Z\" transform=\"translate(198.1 12)\" fill=\"currentColor\"/>\n      </svg>\n      <figcaption><small>Category boundaries: 18.5 \u00b7 25 \u00b7 30. Indicator uses a BMI scale of 10\u201340.</small></figcaption>\n    </figure>\n  </article>\n\n  <p><small>BMI is a general screening tool for adults, not a diagnosis. It does not account for muscle mass, pregnancy, or individual health factors.</small></p>\n</section>\n\n<script>\n(() => {\n  const height = document.getElementById('height');\n  const weight = document.getElementById('weight');\n  const value = document.getElementById('bmi-value');\n  const category = document.getElementById('bmi-category');\n  const message = document.getElementById('bmi-message');\n  const pointer = document.getElementById('bmi-pointer');\n  const description = document.getElementById('scale-description');\n\n  function update() {\n    const h = height.valueAsNumber;\n    const w = weight.valueAsNumber;\n    const bmi = w / ((h / 100) ** 2);\n    const valid = Number.isFinite(h) && Number.isFinite(w) && h > 0 && w > 0 && Number.isFinite(bmi);\n\n    message.hidden = valid;\n    pointer.hidden = !valid;\n    pointer.style.display = valid ? '' : 'none';\n\n    if (!valid) {\n      value.textContent = '\u2014';\n      category.textContent = '';\n      description.textContent = 'Enter valid positive measurements to display your BMI on the category scale.';\n      return;\n    }\n\n    const label = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n    const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    value.textContent = formatted;\n    category.textContent = label;\n    const position = 10 + ((Math.min(40, Math.max(10, bmi)) - 10) / 30) * 440;\n    pointer.setAttribute('transform', `translate(${position} 12)`);\n    description.textContent = `Your BMI is ${formatted}, classified as ${label}. The scale runs from 10 to 40; values outside this range appear at the nearest end.`;\n  }\n\n  height.addEventListener('input', update);\n  weight.addEventListener('input', update);\n  update();\n})();\n</script>",
