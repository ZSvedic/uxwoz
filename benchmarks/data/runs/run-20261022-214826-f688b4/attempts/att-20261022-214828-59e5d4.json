  "extractedSource": "<h1>Mortgage Calculator</h1>\n<form onsubmit=\"return false\">\n<fieldset style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem\">\n<label>Property price ($)<input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\"></label>\n<label>Down payment ($)<input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\"></label>\n<label>Annual interest rate (%)<input id=\"rate\" type=\"number\" min=\"0\" step=\"0.01\" value=\"6.5\"></label>\n<label>Term (years)<input id=\"term\" type=\"number\" min=\"1\" step=\"1\" value=\"30\"></label>\n</fieldset>\n</form>\n<article>\n<div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem\">\n<div><small>Loan principal</small><h3 id=\"principal\"></h3></div>\n<div><small>Monthly payment</small><h3 id=\"monthly\"></h3></div>\n<div><small>Total interest</small><h3 id=\"totalInterest\"></h3></div>\n<div><small>Total payment</small><h3 id=\"totalPayment\"></h3></div>\n</div>\n</article>\n<article>\n<h3>Principal vs. interest by year</h3>\n<svg id=\"chart\" viewBox=\"0 0 600 300\" width=\"100%\" role=\"img\" aria-label=\"Principal versus interest paid per year\"></svg>\n<p><small><mark style=\"background:#3b82f6;color:#fff\">Principal</mark> &nbsp; <mark style=\"background:#f97316;color:#fff\">Interest</mark></small></p>\n</article>\n<article>\n<h3>Annual amortization</h3>\n<div style=\"max-height:400px;overflow:auto\">\n<table>\n<thead><tr><th>Year</th><th>Interest paid</th><th>Principal paid</th><th>Remaining balance</th></tr></thead>\n<tbody id=\"rows\"></tbody>\n</table>\n</div>\n</article>\n<script>\nconst $ = id => document.getElementById(id);\nconst fmt = n => n.toLocaleString(undefined, {style:'currency', currency:'USD'});\nfunction update() {\n  const price = parseFloat($('price').value) || 0;\n  const down = parseFloat($('down').value) || 0;\n  const ratePct = parseFloat($('rate').value) || 0;\n  const years = Math.max(1, Math.round(parseFloat($('term').value) || 1));\n  const P = Math.max(0, price - down);\n  const r = ratePct / 100 / 12;\n  const n = years * 12;\n  const payment = r === 0 ? P / n : P * r / (1 - Math.pow(1 + r, -n));\n  const totalPayment = payment * n;\n  const totalInterest = totalPayment - P;\n  $('principal').textContent = fmt(P);\n  $('monthly').textContent = fmt(payment);\n  $('totalInterest').textContent = fmt(totalInterest);\n  $('totalPayment').textContent = fmt(totalPayment);\n  const rows = [];\n  let balance = P;\n  for (let y = 1; y <= years; y++) {\n    let yInt = 0, yPrin = 0;\n    for (let m = 0; m < 12; m++) {\n      const i = balance * r;\n      const p = payment - i;\n      yInt += i; yPrin += p; balance -= p;\n    }\n    if (balance < 0.005) balance = 0;\n    rows.push({y, yInt, yPrin, balance});\n  }\n  $('rows').innerHTML = rows.map(o =>\n    `<tr><td>${o.y}</td><td>${fmt(o.yInt)}</td><td>${fmt(o.yPrin)}</td><td>${fmt(o.balance)}</td></tr>`).join('');\n  const svg = $('chart');\n  const W = 600, H = 300, pad = 40;\n  const maxV = Math.max(1, ...rows.map(o => o.yInt + o.yPrin));\n  const bw = (W - pad * 2) / rows.length;\n  let bars = '';\n  rows.forEach((o, idx) => {\n    const x = pad + idx * bw;\n    const hp = o.yPrin / maxV * (H - pad * 2);\n    const hi = o.yInt / maxV * (H - pad * 2);\n    const yp = H - pad - hp;\n    const yi = yp - hi;\n    bars += `<rect x=\"${x + 1}\" y=\"${yp}\" width=\"${Math.max(1, bw - 2)}\" height=\"${hp}\" fill=\"#3b82f6\"><title>Year ${o.y}: principal ${fmt(o.yPrin)}</title></rect>`;\n    bars += `<rect x=\"${x + 1}\" y=\"${yi}\" width=\"${Math.max(1, bw - 2)}\" height=\"${hi}\" fill=\"#f97316\"><title>Year ${o.y}: interest ${fmt(o.yInt)}</title></rect>`;\n  });\n  svg.innerHTML = `<line x1=\"${pad}\" y1=\"${H - pad}\" x2=\"${W - pad}\" y2=\"${H - pad}\" stroke=\"currentColor\"/>\n<text x=\"${pad}\" y=\"${H - pad + 18}\" font-size=\"12\" fill=\"currentColor\">Year 1</text>\n<text x=\"${W - pad}\" y=\"${H - pad + 18}\" font-size=\"12\" text-anchor=\"end\" fill=\"currentColor\">Year ${years}</text>\n<text x=\"${pad - 6}\" y=\"${pad}\" font-size=\"12\" text-anchor=\"end\" fill=\"currentColor\">${fmt(maxV)}</text>${bars}`;\n}\ndocument.querySelectorAll('input').forEach(el => el.addEventListener('input', update));\nupdate();\n</script>",
