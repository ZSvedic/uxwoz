alue) || 1));\n  const P = Math.max(0, price - down);\n  const n = years * 12;\n  const r = rate / 100 / 12;\n  const pay = r === 0 ? P / n : P * r / (1 - Math.pow(1 + r, -n));\n  const total = pay * n;\n  const totalInterest = total - P;\n  $(\"principal\").textContent = fmt(P);\n  $(\"monthly\").textContent = fmt(pay);\n  $(\"interest\").textContent = fmt(totalInterest);\n  $(\"total\").textContent = fmt(total);\n  let bal = P;\n  const rows = [];\n  for (let y = 1; y <= years; y++) {\n    let intY = 0, prinY = 0;\n    for (let m = 0; m < 12; m++) {\n      const i = bal * r;\n      const p = pay - i;\n      intY += i; prinY += p; bal -= p;\n    }\n    if (y === years) bal = 0;\n    rows.push({y, intY, prinY, bal: Math.max(0, bal)});\n  }\n  $(\"rows\").innerHTML = rows.map(o =>\n    `<tr><td>${o.y}</td><td>${fmt(o.intY)}</td><td>${fmt(o.prinY)}</td><td>${fmt(o.bal)}</td></tr>`).join(\"\");\n  const W = 600, H = 260, pad = 30;\n  const maxY = Math.max(...rows.map(o => o.intY + o.prinY), 1);\n  const bw = (W - pad * 2) / years;\n  let svg = \"\";\n  rows.forEach((o, idx) => {\n    const x = pad + idx * bw + 1;\n    const scale = (H - pad * 2) / maxY;\n    const hi = o.intY * scale, hp = o.prinY * scale;\n    svg += `<rect x=\"${x}\" y=\"${H - pad - hp}\" width=\"${Math.max(bw - 2, 1)}\" height=\"${hp}\" fill=\"#3b82f6\"><title>Year ${o.y}: principal ${fmt(o.prinY)}</title></rect>`;\n    svg += `<rect x=\"${x}\" y=\"${H - pad - hp - hi}\" width=\"${Math.max(bw - 2, 1)}\" height=\"${hi}\" fill=\"#f59e0b\"><title>Year ${o.y}: interest ${fmt(o.intY)}</title></rect>`;\n  });\n  svg += `<line x1=\"${pad}\" y1=\"${H - pad}\" x2=\"${W - pad}\" y2=\"${H - pad}\" stroke=\"currentColor\"/>`;\n  svg += `<text x=\"${pad}\" y=\"${H - 8}\" font-size=\"12\" fill=\"currentColor\">Year 1</text>`;\n  svg += `<text x=\"${W - pad}\" y=\"${H - 8}\" font-size=\"12\" text-anchor=\"end\" fill=\"currentColor\">Year ${years}</text>`;\n  $(\"chart\").innerHTML = svg;\n}\ndocument.querySelectorAll(\"input\").forEach(el => el.addEventListener(\"input\", update));\nupdate();\n</script>",
