 "harness": {
  "extractedSource": "<article>\n  <h2>BMI calculator</h2>\n  <p>Enter your height and weight to see your body mass index.</p>\n  <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:1rem\">\n    <label>Height (cm)\n      <input id=\"height\" type=\"number\" min=\"1\" step=\"1\" value=\"175\">\n    </label>\n    <label>Weight (kg)\n      <input id=\"weight\" type=\"number\" min=\"1\" step=\"0.1\" value=\"70\">\n    </label>\n  </div>\n  <p><strong id=\"bmi\">22.9</strong> BMI \u00b7 <mark id=\"category\">Normal</mark></p>\n  <svg viewBox=\"0 0 400 34\" role=\"img\" aria-label=\"BMI category scale\" style=\"width:100%;height:auto\">\n    <rect x=\"0\" y=\"8\" width=\"92.6\" height=\"16\" fill=\"#74b9d2\"/>\n    <rect x=\"92.6\" y=\"8\" width=\"77.1\" height=\"16\" fill=\"#61b883\"/>\n    <rect x=\"169.7\" y=\"8\" width=\"77.1\" height=\"16\" fill=\"#f2c14e\"/>\n    <rect x=\"246.8\" y=\"8\" width=\"153.2\" height=\"16\" fill=\"#df7777\"/>\n    <line id=\"marker\" x1=\"127\" x2=\"127\" y1=\"2\" y2=\"30\" stroke=\"currentColor\" stroke-width=\"3\"/>\n  </svg>\n  <small>Underweight &lt;18.5 \u00b7 Normal 18.5\u2013&lt;25 \u00b7 Overweight 25\u2013&lt;30 \u00b7 Obese \u226530</small>\n</article>\n<script>\nconst h=document.getElementById('height'), w=document.getElementById('weight');\nfunction update(){\n  const height=Number(h.value)/100, weight=Number(w.value);\n  const bmi=height>0&&weight>0?weight/(height*height):0;\n  const rounded=Math.round(bmi*10)/10;\n  document.getElementById('bmi').textContent=rounded.toFixed(1);\n  document.getElementById('category').textContent=bmi<18.5?'Underweight':bmi<25?'Normal':bmi<30?'Overweight':'Obese';\n  const x=Math.max(0,Math.min(400,bmi/40*400));\n  document.getElementById('marker').setAttribute('x1',x);\n  document.getElementById('marker').setAttribute('x2',x);\n}\nh.addEventListener('input',update); w.addEventListener('input',update);\nupdate();\n</script>",
