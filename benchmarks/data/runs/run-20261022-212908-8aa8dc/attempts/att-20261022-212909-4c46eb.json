 "harness": {
  "extractedSource": "<main>\n  <article>\n    <h2>BMI calculator</h2>\n    <p>Enter your height and weight to see your body mass index.</p>\n    <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:1rem\">\n      <label>Height (cm)\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"1\" value=\"175\">\n      </label>\n      <label>Weight (kg)\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"0.1\" value=\"70\">\n      </label>\n    </div>\n    <p><strong>BMI: <span id=\"bmi\">22.9</span></strong> \u00b7 <span id=\"category\">Normal</span></p>\n    <div aria-label=\"BMI category scale\" style=\"position:relative;padding-top:1.5rem\">\n      <span id=\"marker\" aria-label=\"Current BMI\" style=\"position:absolute;top:0;left:43%;transform:translateX(-50%)\">\u25bc</span>\n      <div style=\"display:flex;height:1rem;border-radius:1rem;overflow:hidden\">\n        <span style=\"width:25%;background:#75b9e7\"></span>\n        <span style=\"width:25%;background:#73c99a\"></span>\n        <span style=\"width:25%;background:#f2c45c\"></span>\n        <span style=\"width:25%;background:#e77f75\"></span>\n      </div>\n      <div style=\"display:flex;justify-content:space-between\"><small>Underweight</small><small>Normal</small><small>Overweight</small><small>Obese</small></div>\n    </div>\n    <small>Scale ranges: &lt;18.5 \u00b7 18.5\u201324.9 \u00b7 25\u201329.9 \u00b7 \u226530</small>\n  </article>\n</main>\n<script>\nconst height=document.querySelector(\"#height\"), weight=document.querySelector(\"#weight\");\nfunction update(){\n  const h=Number(height.value)/100,w=Number(weight.value);\n  if(!h||!w)return;\n  const value=w/(h*h), rounded=value.toFixed(1);\n  document.querySelector(\"#bmi\").textContent=rounded;\n  document.querySelector(\"#category\").textContent=value<18.5?\"Underweight\":value<25?\"Normal\":value<30?\"Overweight\":\"Obese\";\n  document.querySelector(\"#marker\").style.left=Math.max(0,Math.min(100,value/40*100))+\"%\";\n}\nheight.addEventListener(\"input\",update);weight.addEventListener(\"input\",update);\n</script>",
