  "extractedSource": "<main>\n  <h1>Mortgage calculator</h1>\n  <fieldset>\n    <label>Property price ($)<input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\"></label>\n    <label>Down payment ($)<input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\"></label>\n    <label>Annual interest rate (%)<input id=\"rate\" type=\"number\" min=\"0\" step=\"0.01\" value=\"6.5\"></label>\n    <label>Term (years)<input id=\"years\" type=\"number\" min=\"1\" step=\"1\" value=\"30\"></label>\n  </fieldset>\n  <section style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem\">\n    <article><small>Loan principal</small><h3 id=\"principal\"></h3></article>\n    <article><small>Monthly payment</small><h3 id=\"monthly\"></h3></article>\n    <article><small>Total interest</small><h3 id=\"interest\"></h3></article>\n    <article><small>Total payment</small><h3 id=\"total\"></h3></article>\n  </section>\n  <h2>Annual principal and interest</h2>\n  <svg id=\"chart\" viewBox=\"0 0 720 260\" role=\"img\" aria-label=\"Annual principal and interest paid chart\" style=\"width:100%;height:auto\"></svg>\n  <p><small><mark style=\"background:#1976d2;color:white\">Principal</mark> <mark style=\"background:#f0a000;color:white\">Interest</mark></small></p>\n  <h2>Amortization by year</h2>\n  <div style=\"overflow-x:auto\">\n    <table><thead><tr><th>Year</th><th>Interest paid</th><th>Principal paid</th><th>Remaining balance</th></tr></thead><tbody id=\"rows\"></tbody></table>\n  </div>\n</main>\n<script>\nconst ids=[\"price\",\"down\",\"rate\",\"years\"], el=id=>document.getElementById(id), money=n=>\"$\"+n.toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});\nfunction update(){\n const price=+el(\"price\").value||0, down=+el(\"down\").value||0, rate=(+el(\"rate\").value||0)/1200, years=Math.max(1,Math.floor(+el(\"years\").value||1)), n=years*12, p=price-down;\n const pay=rate? p*rate/(1-Math.pow(1+rate,-n)):p/n;\n el(\"principal\").textContent=money(p); el(\"monthly\").textContent=money(pay);\n el(\"total\").textContent=money(pay*n); el(\"interest\").textContent=money(pay*n-p);\n let balance=p, data=[], rows=\"\";\n for(let y=1;y<=years;y++){\n  let ip=0,pp=0;\n  for(let m=0;m<12;m++){let i=balance*rate, pr=pay-i; ip+=i; pp+=pr; balance-=pr;}\n  if(y===years&&Math.abs(balance)<.01)balance=0;\n  data.push({ip,pp}); rows+=`<tr><th>${y}</th><td>${money(ip)}</td><td>${money(pp)}</td><td>${money(Math.max(0,balance))}</td></tr>`;\n }\n el(\"rows\").innerHTML=rows;\n const svg=el(\"chart\"), W=720,H=260,pad=30,max=Math.max(1,...data.map(d=>d.ip+d.pp)), step=(W-2*pad)/years,bw=Math.max(1,step*.62);\n let s=`<line x1=\"${pad}\" y1=\"${H-pad}\" x2=\"${W-pad}\" y2=\"${H-pad}\" stroke=\"currentColor\"/>`;\n data.forEach((d,i)=>{let x=pad+i*step+(step-bw)/2, h1=d.pp/max*(H-2*pad),h2=d.ip/max*(H-2*pad),base=H-pad;\n s+=`<rect x=\"${x}\" y=\"${base-h1}\" width=\"${bw}\" height=\"${h1}\" fill=\"#1976d2\"><title>Year ${i+1}: principal ${money(d.pp)}</title></rect><rect x=\"${x}\" y=\"${base-h1-h2}\" width=\"${bw}\" height=\"${h2}\" fill=\"#f0a000\"><title>Year ${i+1}: interest ${money(d.ip)}</title></rect>`;});\n svg.innerHTML=s;\n}\nids.forEach(id=>el(id).addEventListener(\"input\",update)); update();\n</script>",
