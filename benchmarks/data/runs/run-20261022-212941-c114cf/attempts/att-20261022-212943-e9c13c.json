al=0;rows.push({yr,ip,pp,bal:Math.max(0,bal)})}\n $('principal').textContent=money(P);$('monthly').textContent=money(m);$('interest').textContent=money(m*n-P);$('total').textContent=money(m*n);\n $('rows').innerHTML=rows.map(a=>`<tr><th>${a.yr}</th><td>${money(a.ip)}</td><td>${money(a.pp)}</td><td>${money(a.bal)}</td></tr>`).join('');\n const svg=$('chart'), max=Math.max(1,...rows.map(a=>a.ip+a.pp)), w=720,h=220,left=42,bottom=205,step=(w-left-10)/y,bw=Math.max(1,step*.62);\n svg.innerHTML='<line x1=\"42\" y1=\"205\" x2=\"715\" y2=\"205\" stroke=\"currentColor\"/>'+rows.map((a,i)=>{let x=left+i*step+step*.19, ph=a.pp/max*180,ih=a.ip/max*180;return `<g tabindex=\"0\"><title>Year ${a.yr}: principal ${money(a.pp)}, interest ${money(a.ip)}</title><rect x=\"${x}\" y=\"${bottom-ph}\" width=\"${bw}\" height=\"${ph}\" fill=\"#16794b\"/><rect x=\"${x}\" y=\"${bottom-ph-ih}\" width=\"${bw}\" height=\"${ih}\" fill=\"#d98b19\"/></g>`}).join('')+'<text x=\"48\" y=\"18\" fill=\"currentColor\">Principal</text><rect x=\"12\" y=\"8\" width=\"12\" height=\"12\" fill=\"#16794b\"/><text x=\"150\" y=\"18\" fill=\"currentColor\">Interest</text><rect x=\"114\" y=\"8\" width=\"12\" height=\"12\" fill=\"#d98b19\"/>';\n}\ndocument.querySelectorAll('input').forEach(el=>el.addEventListener('input',update));update();\n</script>",
