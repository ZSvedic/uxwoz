  "extractedSource": "<main>\n  <h1>Mortgage calculator</h1>\n  <section style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem\">\n    <label>Property price ($)<input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\"></label>\n    <label>Down payment ($)<input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\"></label>\n    <label>Annual interest rate (%)<input id=\"rate\" type=\"number\" min=\"0\" step=\"0.01\" value=\"6.5\"></label>\n    <label>Term (years)<input id=\"years\" type=\"number\" min=\"1\" step=\"1\" value=\"30\"></label>\n  </section>\n  <section style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem\">\n    <article><small>Loan principal</small><h3 id=\"principal\"></h3></article>\n    <article><small>Monthly payment</small><h3 id=\"monthly\"></h3></article>\n    <article><small>Total interest</small><h3 id=\"interest\"></h3></article>\n    <article><small>Total payment</small><h3 id=\"total\"></h3></article>\n  </section>\n  <article>\n    <h2>Annual principal and interest</h2>\n    <p><small>Hover or focus a bar for yearly amounts.</small></p>\n    <svg id=\"chart\" viewBox=\"0 0 800 240\" role=\"img\" aria-label=\"Annual principal and interest chart\" style=\"width:100%;height:auto\"></svg>\n    <p><mark>Principal</mark> &nbsp; <mark>Interest</mark></p>\n  </article>\n  <h2>Annual amortization</h2>\n  <div style=\"overflow-x:auto\"><table>\n    <thead><tr><th>Year</th><th>Interest paid</th><th>Principal paid</th><th>Remaining balance</th></tr></thead>\n    <tbody id=\"rows\"></tbody>\n  </table></div>\n</main>\n<script>\nconst $=id=>document.getElementById(id), money=x=>'$'+(x||0).toLocaleString(undefined,{minimumFractionDigits:2,maximumFractionDigits:2});\nfunction update(){\n const P=Math.max(0,+$('price').value-(+$('down').value||0)), y=Math.max(1,Math.floor(+$('years').value||1)), n=y*12, r=(+$('rate').value||0)/1200;\n const m=r?P*r/(1-Math.pow(1+r,-n)):P/n;\n $('principal').textContent=money(P); $('monthly').textContent=money(m); $('total').textContent=money(m*n); $('interest').textContent=money(m*n-P);\n let bal=P, data=[];\n for(let yr=1;yr<=y;yr++){let ip=0,pp=0;for(let k=0;k<12;k++){let i=bal*r,pr=Math.min(bal,m-i);ip+=i;pp+=pr;bal=Math.max(0,bal-pr)}data.push({yr,ip,pp,bal})}\n $('rows').innerHTML=data.map(d=>`<tr><td>${d.yr}</td><td>${money(d.ip)}</td><td>${money(d.pp)}</td><td>${money(d.bal)}</td></tr>`).join('');\n const svg=$('chart'), max=Math.max(1,...data.map(d=>d.ip+d.pp)), w=800/data.length, h=190;\n svg.innerHTML='<line x1=\"0\" y1=\"200\" x2=\"800\" y2=\"200\" stroke=\"currentColor\"/>'+data.map((d,i)=>{let x=i*w+2,bh=d.pp/max*h,ih=d.ip/max*h;return `<g tabindex=\"0\"><title>Year ${d.yr}: principal ${money(d.pp)}, interest ${money(d.ip)}</title><rect x=\"${x}\" y=\"${200-bh}\" width=\"${Math.max(1,w-4)}\" height=\"${bh}\" fill=\"#287a55\"/><rect x=\"${x}\" y=\"${200-bh-ih}\" width=\"${Math.max(1,w-4)}\" height=\"${ih}\" fill=\"#d99b32\"/><text x=\"${x+w/2}\" y=\"218\" text-anchor=\"middle\" font-size=\"10\">${d.yr}</text></g>`}).join('');\n}\ndocument.querySelectorAll('input').forEach(e=>e.addEventListener('input',update));update();\n</script>",
