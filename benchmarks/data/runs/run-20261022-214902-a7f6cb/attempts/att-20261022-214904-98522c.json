 "source": "<article>\n<h1>Todo list</h1>\n<form id=\"addForm\" style=\"display:grid;grid-template-columns:1fr auto;gap:0.5rem;align-items:end;\">\n<label>New task<input id=\"newTask\" type=\"text\" autocomplete=\"off\"></label>\n<button type=\"submit\">Add</button>\n</form>\n<label>Filter\n<select id=\"filter\">\n<option value=\"all\">All</option>\n<option value=\"active\">Active</option>\n<option value=\"done\">Done</option>\n</select>\n</label>\n<table>\n<tbody id=\"list\"></tbody>\n</table>\n<p><small id=\"counter\"></small></p>\n</article>\n<script>\nconst tasks = [\n{ text: \"Buy milk\", done: false },\n{ text: \"Write report\", done: true },\n{ text: \"Call Alice\", done: false }\n];\nconst form = document.getElementById(\"addForm\");\nconst input = document.getElementById(\"newTask\");\nconst filter = document.getElementById(\"filter\");\nconst list = document.getElementById(\"list\");\nconst counter = document.getElementById(\"counter\");\n\nfunction render() {\nconst f = filter.value;\nlist.innerHTML = \"\";\ntasks.forEach((t, i) => {\nif (f === \"active\" && t.done) return;\nif (f === \"done\" && !t.done) return;\nconst tr = document.createElement(\"tr\");\nconst tdCheck = document.createElement(\"td\");\nconst cb = document.createElement(\"input\");\ncb.type = \"checkbox\";\ncb.checked = t.done;\ncb.addEventListener(\"change\", () => { t.done = cb.checked; render(); });\ntdCheck.appendChild(cb);\nconst tdText = document.createElement(\"td\");\ntdText.textContent = t.text;\nif (t.done) tdText.style.textDecoration = \"line-through\";\nconst tdDel = document.createElement(\"td\");\nconst del = document.createElement(\"button\");\ndel.type = \"button\";\ndel.textContent = \"Delete\";\ndel.addEventListener(\"click\", () => { tasks.splice(i, 1); render(); });\ntdDel.appendChild(del);\ntr.append(tdCheck, tdText, tdDel);\nlist.appendChild(tr);\n});\nconst left = tasks.filter(t => !t.done).length;\ncounter.textContent = left + (left === 1 ? \" item left\" : \" items left\");\n}\n\nform.addEventListener(\"submit\", e => {\ne.preventDefault();\nconst text = input.value.trim();\nif (text) tasks.push({ text, done: false });\ninput.value = \"\";\nrender();\n});\nfilter.addEventListener(\"input\", render);\nrender();\n</script>",
