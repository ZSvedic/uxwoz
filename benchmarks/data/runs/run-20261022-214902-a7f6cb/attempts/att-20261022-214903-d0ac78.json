 "source": "<h1>Todo list</h1>\n<form id=\"addForm\" style=\"display:flex;gap:0.5rem;align-items:end\">\n<label style=\"flex:1\">New task<input id=\"newTask\" type=\"text\" autocomplete=\"off\"></label>\n<button id=\"addBtn\" type=\"submit\">Add</button>\n</form>\n<fieldset style=\"display:flex;gap:1rem;flex-wrap:wrap\">\n<legend>Filter</legend>\n<label><input type=\"radio\" name=\"filter\" value=\"all\" checked> All</label>\n<label><input type=\"radio\" name=\"filter\" value=\"active\"> Active</label>\n<label><input type=\"radio\" name=\"filter\" value=\"done\"> Done</label>\n</fieldset>\n<p><small id=\"counter\"></small></p>\n<table>\n<tbody id=\"list\"></tbody>\n</table>\n<script>\nlet tasks = [\n{ id: 1, text: \"Buy milk\", done: false },\n{ id: 2, text: \"Write report\", done: true },\n{ id: 3, text: \"Call Alice\", done: false }\n];\nlet nextId = 4;\nlet filter = \"all\";\n\nconst list = document.getElementById(\"list\");\nconst counter = document.getElementById(\"counter\");\nconst newTask = document.getElementById(\"newTask\");\n\nfunction render() {\nconst shown = tasks.filter(t =>\nfilter === \"all\" || (filter === \"active\" && !t.done) || (filter === \"done\" && t.done)\n);\nlist.innerHTML = \"\";\nshown.forEach(t => {\nconst tr = document.createElement(\"tr\");\nconst tdCheck = document.createElement(\"td\");\nconst cb = document.createElement(\"input\");\ncb.type = \"checkbox\";\ncb.checked = t.done;\ncb.addEventListener(\"change\", () => { t.done = cb.checked; render(); });\ntdCheck.appendChild(cb);\nconst tdText = document.createElement(\"td\");\ntdText.textContent = t.text;\nif (t.done) tdText.style.textDecoration = \"line-through\";\nconst tdDel = document.createElement(\"td\");\nconst del = document.createElement(\"button\");\ndel.type = \"button\";\ndel.textContent = \"Delete\";\ndel.addEventListener(\"click\", () => { tasks = tasks.filter(x => x.id !== t.id); render(); });\ntdDel.appendChild(del);\ntr.append(tdCheck, tdText, tdDel);\nlist.appendChild(tr);\n});\nconst left = tasks.filter(t => !t.done).length;\ncounter.textContent = `${left} item${left === 1 ? \"\" : \"s\"} left`;\n}\n\ndocument.getElementById(\"addForm\").addEventListener(\"submit\", e => {\ne.preventDefault();\nconst text = newTask.value.trim();\nif (!text) return;\ntasks.push({ id: nextId++, text, done: false });\nnewTask.value = \"\";\nrender();\n});\n\ndocument.querySelectorAll('input[name=\"filter\"]').forEach(r =>\nr.addEventListener(\"change\", () => { filter = r.value; render(); })\n);\n\nrender();\n</script>",
