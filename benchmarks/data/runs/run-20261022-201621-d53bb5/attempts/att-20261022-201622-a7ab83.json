 "harness": {
  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 580px; margin: 2rem auto; padding: 0 1rem;\">\n  <header>\n    <h1 id=\"bmi-title\">BMI calculator</h1>\n    <p>Check your body mass index in a moment.</p>\n  </header>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;\">\n      <label for=\"height\">Height <small>(cm)</small>\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"any\" value=\"175\" inputmode=\"decimal\" required>\n      </label>\n      <label for=\"weight\">Weight <small>(kg)</small>\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"any\" value=\"70\" inputmode=\"decimal\" required>\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><output id=\"bmi\" for=\"height weight\">22.9</output> <small id=\"category\">Normal</small></h2>\n      <p id=\"error\" hidden>Please enter a valid height and weight greater than zero.</p>\n    </div>\n\n    <figure style=\"margin: 1rem 0;\">\n      <svg id=\"scale\" viewBox=\"0 0 460 110\" role=\"img\" aria-labelledby=\"scale-title scale-description\" style=\"display: block; width: 100%; height: auto;\">\n        <title id=\"scale-title\">BMI category scale</title>\n        <desc id=\"scale-description\">Your BMI is 22.9, in the Normal category.</desc>\n        <rect x=\"10\" y=\"34\" width=\"119\" height=\"18\" rx=\"3\" fill=\"#78b4d5\"></rect>\n        <rect x=\"129\" y=\"34\" width=\"91\" height=\"18\" fill=\"#78bd91\"></rect>\n        <rect x=\"220\" y=\"34\" width=\"70\" height=\"18\" fill=\"#edc567\"></rect>\n        <rect x=\"290\" y=\"34\" width=\"160\" height=\"18\" rx=\"3\" fill=\"#dc8a83\"></rect>\n        <g fill=\"currentColor\" font-family=\"sans-serif\" font-size=\"12\" text-anchor=\"middle\">\n          <text x=\"129\" y=\"70\">18.5</text>\n          <text x=\"220\" y=\"70\">25</text>\n          <text x=\"290\" y=\"70\">30</text>\n          <text x=\"69\" y=\"96\">Underweight</text>\n          <text x=\"174\" y=\"96\">Normal</text>\n          <text x=\"255\" y=\"96\">Overweight</text>\n          <text x=\"370\" y=\"96\">Obese</text>\n        </g>\n        <g id=\"marker\" transform=\"translate(191, 0)\" fill=\"currentColor\">\n          <text id=\"marker-label\" x=\"0\" y=\"17\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"13\" font-weight=\"bold\">22.9</text>\n          <path d=\"M -6 23 L 6 23 L 0 31 Z\"></path>\n          <rect x=\"-1\" y=\"33\" width=\"2\" height=\"21\"></rect>\n        </g>\n      </svg>\n      <figcaption><small>BMI = weight (kg) \u00f7 height (m)\u00b2</small></figcaption>\n    </figure>\n  </article>\n\n  <p><small>BMI is a general screening tool for adults, not a diagnosis. It does not account for muscle mass, pregnancy, or individual health factors.</small></p>\n</section>\n\n<script>\n  (() => {\n    const height = document.getElementById('height');\n    const weight = document.getElementById('weight');\n    const bmiOutput = document.getElementById('bmi');\n    const categoryOutput = document.getElementById('category');\n    const error = document.getElementById('error');\n    const marker = document.getElementById('marker');\n    const markerLabel = document.getElementById('marker-label');\n    const description = document.getElementById('scale-description');\n\n    function update() {\n      const h = height.valueAsNumber;\n      const w = weight.valueAsNumber;\n      const bmi = w / ((h / 100) ** 2);\n      const valid = Number.isFinite(h) && Number.isFinite(w) && h > 0 && w > 0 && Number.isFinite(bmi);\n      error.hidden = valid;\n      marker.hidden = !valid;\n      marker.setAttribute('visibility', valid ? 'visible' : 'hidden');\n      if (!valid) {\n        bmiOutput.textContent = '\u2014';\n        categoryOutput.textContent = '';\n        description.textContent = 'Enter a valid height and weight to show your BMI on the scale.';\n        return;\n      }\n      const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n      const category = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n      bmiOutput.textContent = formatted;\n      categoryOutput.textContent = category;\n      markerLabel.textContent = formatted;\n      let x;\n      if (bmi < 18.5) x = 10 + (bmi / 18.5) * 119;\n      else if (bmi < 25) x = 129 + ((bmi - 18.5) / 6.5) * 91;\n      else if (bmi < 30) x = 220 + ((bmi - 25) / 5) * 70;\n      else x = 290 + Math.min((bmi - 30) / 15, 1) * 160;\n      marker.setAttribute('transform', `translate(${Math.max(30, Math.min(430, x))}, 0)`);\n      description.textContent = `Your BMI is ${formatted}, in the ${category} category. Category boundaries are 18.5, 25, and 30. Values above 45 appear at the right end of the scale.`;\n    }\n\n    height.addEventListener('input', update);\n    weight.addEventListener('input', update);\n    update();\n  })();\n</script>",
