 "harness": {
  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 560px; margin: 0 auto;\">\n  <header>\n    <h1 id=\"bmi-title\">BMI calculator</h1>\n    <p>Check your body mass index in a moment.</p>\n  </header>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;\">\n      <label for=\"height\">Height <small>(cm)</small>\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"any\" value=\"175\" inputmode=\"decimal\">\n      </label>\n      <label for=\"weight\">Weight <small>(kg)</small>\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"any\" value=\"70\" inputmode=\"decimal\">\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><output id=\"bmi\" for=\"height weight\">22.9</output> <small id=\"category\">Normal</small></h2>\n      <p id=\"message\">Within the normal BMI range.</p>\n    </div>\n\n    <svg viewBox=\"0 0 440 90\" role=\"img\" aria-labelledby=\"scale-title scale-description\" style=\"display: block; width: 100%; height: auto;\">\n      <title id=\"scale-title\">BMI category scale</title>\n      <desc id=\"scale-description\">BMI 22.9, Normal. Scale shown from 10 to 40.</desc>\n      <rect x=\"20\" y=\"26\" width=\"113.33\" height=\"16\" fill=\"#4385b5\"/>\n      <rect x=\"133.33\" y=\"26\" width=\"86.67\" height=\"16\" fill=\"#39845c\"/>\n      <rect x=\"220\" y=\"26\" width=\"66.67\" height=\"16\" fill=\"#bc8525\"/>\n      <rect x=\"286.67\" y=\"26\" width=\"133.33\" height=\"16\" fill=\"#b65151\"/>\n      <g fill=\"currentColor\" font-size=\"12\" text-anchor=\"middle\">\n        <text x=\"20\" y=\"60\">10</text>\n        <text x=\"133.33\" y=\"60\">18.5</text>\n        <text x=\"220\" y=\"60\">25</text>\n        <text x=\"286.67\" y=\"60\">30</text>\n        <text x=\"420\" y=\"60\">40</text>\n      </g>\n      <path id=\"marker\" d=\"M 186 22 L 180 10 L 192 10 Z\" fill=\"currentColor\"/>\n    </svg>\n\n    <small>Blue: Underweight \u00b7 Green: Normal \u00b7 Amber: Overweight \u00b7 Red: Obese</small>\n    <p><small>Scale: BMI 10\u201340. Values outside this range appear at the nearest end.</small></p>\n\n    <details>\n      <summary>How to interpret your result</summary>\n      <table>\n        <thead><tr><th scope=\"col\">Category</th><th scope=\"col\">BMI</th></tr></thead>\n        <tbody>\n          <tr><td>Underweight</td><td>Below 18.5</td></tr>\n          <tr><td>Normal</td><td>18.5 to below 25</td></tr>\n          <tr><td>Overweight</td><td>25 to below 30</td></tr>\n          <tr><td>Obese</td><td>30 or above</td></tr>\n        </tbody>\n      </table>\n      <p><small>BMI = weight (kg) \u00f7 height (m)\u00b2. Categories use the unrounded result.</small></p>\n    </details>\n  </article>\n  <p><small>BMI is a general screening measure for adults, not a diagnosis. It does not account for muscle mass, pregnancy, or individual health differences.</small></p>\n</section>\n\n<script>\n(() => {\n  const height = document.getElementById('height');\n  const weight = document.getElementById('weight');\n  const result = document.getElementById('bmi');\n  const category = document.getElementById('category');\n  const message = document.getElementById('message');\n  const marker = document.getElementById('marker');\n  const description = document.getElementById('scale-description');\n\n  function update() {\n    const h = height.valueAsNumber;\n    const w = weight.valueAsNumber;\n    const bmi = w / ((h / 100) ** 2);\n\n    if (!Number.isFinite(h) || !Number.isFinite(w) || h <= 0 || w <= 0 || !Number.isFinite(bmi) || bmi <= 0) {\n      result.textContent = '\u2014';\n      category.textContent = '';\n      message.textContent = 'Enter a valid height and weight greater than zero.';\n      marker.setAttribute('visibility', 'hidden');\n      description.textContent = 'Enter valid measurements to show your BMI on the scale.';\n      return;\n    }\n\n    const label = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n    const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    result.textContent = formatted;\n    category.textContent = label;\n    message.textContent = label === 'Normal' ? 'Within the normal BMI range.' : 'In the ' + label.toLowerCase() + ' BMI range.';\n    const x = 20 + ((Math.min(40, Math.max(10, bmi)) - 10) / 30) * 400;\n    marker.setAttribute('d', `M ${x} 22 L ${x - 6} 10 L ${x + 6} 10 Z`);\n    marker.removeAttribute('visibility');\n    description.textContent = `BMI ${formatted}, ${label}. Scale shown from 10 to 40.`;\n  }\n\n  height.addEventListener('input', update);\n  weight.addEventListener('input', update);\n  update();\n})();\n</script>",
