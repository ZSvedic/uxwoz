  "extractedSource": "<section aria-labelledby=\"bmi-title\" style=\"max-width: 540px; margin: 2rem auto; padding: 0 1rem;\">\n  <header>\n    <h1 id=\"bmi-title\">BMI calculator</h1>\n    <p>Check your body mass index with your height and weight.</p>\n  </header>\n\n  <article>\n    <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;\">\n      <label for=\"height\">Height <small>(cm)</small>\n        <input id=\"height\" type=\"number\" min=\"1\" step=\"any\" value=\"175\" inputmode=\"decimal\" required>\n      </label>\n      <label for=\"weight\">Weight <small>(kg)</small>\n        <input id=\"weight\" type=\"number\" min=\"1\" step=\"any\" value=\"70\" inputmode=\"decimal\" required>\n      </label>\n    </div>\n\n    <div aria-live=\"polite\" aria-atomic=\"true\">\n      <small>Your BMI</small>\n      <h2><output id=\"bmi\" for=\"height weight\">22.9</output> <small id=\"category\">Normal</small></h2>\n      <p id=\"message\" hidden>Enter a positive height and weight to calculate your BMI.</p>\n    </div>\n\n    <svg id=\"scale\" viewBox=\"0 0 440 100\" role=\"img\" aria-labelledby=\"scale-title scale-desc\" style=\"width: 100%; height: auto;\">\n      <title id=\"scale-title\">BMI category scale</title>\n      <desc id=\"scale-desc\">BMI 22.9, Normal. The scale displays BMI 10 to 40.</desc>\n      <rect x=\"16\" y=\"30\" width=\"115.6\" height=\"18\" fill=\"#4c86aa\"/>\n      <rect x=\"131.6\" y=\"30\" width=\"88.4\" height=\"18\" fill=\"#368368\"/>\n      <rect x=\"220\" y=\"30\" width=\"68\" height=\"18\" fill=\"#c18a29\"/>\n      <rect x=\"288\" y=\"30\" width=\"136\" height=\"18\" fill=\"#b95353\"/>\n      <path id=\"marker\" d=\"M 191.4 27 L 185.4 16 L 197.4 16 Z\" fill=\"currentColor\"/>\n      <g fill=\"currentColor\" font-size=\"12\" text-anchor=\"middle\">\n        <text x=\"16\" y=\"66\">10</text>\n        <text x=\"131.6\" y=\"66\">18.5</text>\n        <text x=\"220\" y=\"66\">25</text>\n        <text x=\"288\" y=\"66\">30</text>\n        <text x=\"424\" y=\"66\">40</text>\n      </g>\n      <text x=\"220\" y=\"91\" fill=\"currentColor\" font-size=\"12\" text-anchor=\"middle\">BMI \u2022 pointer limited to the displayed range</text>\n    </svg>\n\n    <small>Underweight &lt; 18.5 \u00b7 Normal 18.5\u201324.9<br>Overweight 25\u201329.9 \u00b7 Obese \u2265 30</small>\n  </article>\n  <p><small>BMI is a general screening tool for adults, not a diagnosis. It does not account for muscle mass, pregnancy, or individual health factors.</small></p>\n</section>\n\n<script>\n(() => {\n  const height = document.getElementById('height');\n  const weight = document.getElementById('weight');\n  const result = document.getElementById('bmi');\n  const category = document.getElementById('category');\n  const message = document.getElementById('message');\n  const marker = document.getElementById('marker');\n  const description = document.getElementById('scale-desc');\n\n  function update() {\n    const h = height.valueAsNumber;\n    const w = weight.valueAsNumber;\n    const bmi = w / ((h / 100) ** 2);\n    const valid = h > 0 && w > 0 && Number.isFinite(bmi);\n    message.hidden = valid;\n    marker.hidden = !valid;\n    marker.setAttribute('visibility', valid ? 'visible' : 'hidden');\n    if (!valid) {\n      result.textContent = '\u2014';\n      category.textContent = '';\n      description.textContent = 'Enter a positive height and weight to show your position on the BMI scale.';\n      return;\n    }\n    const label = bmi < 18.5 ? 'Underweight' : bmi < 25 ? 'Normal' : bmi < 30 ? 'Overweight' : 'Obese';\n    const formatted = bmi.toLocaleString(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\n    result.textContent = formatted;\n    category.textContent = label;\n    const x = 16 + (Math.max(10, Math.min(40, bmi)) - 10) / 30 * 408;\n    marker.setAttribute('d', `M ${x} 27 L ${x - 6} 16 L ${x + 6} 16 Z`);\n    description.textContent = `BMI ${formatted}, ${label}. The scale displays BMI 10 to 40; values outside this range appear at the nearest end.`;\n  }\n\n  height.addEventListener('input', update);\n  weight.addEventListener('input', update);\n  update();\n})();\n</script>",
