  "extractedSource": "<main>\n  <h1>Mortgage calculator</h1>\n  <p>Estimate your fixed-rate mortgage payment and explore how each year\u2019s payments reduce your balance.</p>\n\n  <section aria-label=\"Mortgage inputs\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\">\n    <label for=\"price\">Property price ($)\n      <input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"down\">Down payment ($)\n      <input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"rate\">Annual interest rate (%)\n      <input id=\"rate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"6.5\" inputmode=\"decimal\">\n    </label>\n    <label for=\"term\">Term (years)\n      <input id=\"term\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" value=\"30\" inputmode=\"numeric\">\n    </label>\n  </section>\n\n  <p id=\"error\" role=\"alert\" hidden></p>\n\n  <section id=\"results\" aria-label=\"Mortgage results\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem\" aria-live=\"polite\">\n      <article><small>Loan principal</small><h2 id=\"principal\"></h2></article>\n      <article><small>Monthly payment</small><h2 id=\"monthly\"></h2></article>\n      <article><small>Total interest</small><h2 id=\"interest\"></h2></article>\n      <article><small>Total payment</small><h2 id=\"total\"></h2></article>\n    </div>\n    <p><small>Principal and interest only. Excludes taxes, insurance, HOA fees and closing costs. Total payment excludes your down payment. Calculations use unrounded payments; displayed amounts are rounded.</small></p>\n\n    <article>\n      <h2>Annual principal and interest</h2>\n      <p><span style=\"color:#167d9a\">\u25cf Principal paid</span> &nbsp; <span style=\"color:#a45116\">\u25cf Interest paid</span></p>\n      <svg id=\"chart\" viewBox=\"0 0 900 340\" role=\"img\" aria-labelledby=\"chartTitle chartDesc\" style=\"width:100%;height:auto\">\n        <title id=\"chartTitle\">Annual mortgage payments</title>\n        <desc id=\"chartDesc\">Stacked bars show principal and interest paid each year. Select a year below for exact values.</desc>\n        <g id=\"plot\"></g>\n      </svg>\n      <label for=\"year\">Explore year <output id=\"yearNumber\" for=\"year\">1</output>\n        <input id=\"year\" type=\"range\" min=\"1\" max=\"30\" value=\"1\" step=\"1\">\n      </label>\n      <p id=\"yearDetail\" aria-live=\"polite\"></p>\n      <small>Hover over or tap a bar, or use the year slider to explore.</small>\n    </article>\n\n    <section>\n      <h2>Annual amortization schedule</h2>\n      <div style=\"overflow-x:auto\">\n        <table>\n          <caption>Payments and remaining balance by year</caption>\n          <thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Interest paid</th><th scope=\"col\">Principal paid</th><th scope=\"col\">Remaining balance</th></tr></thead>\n          <tbody id=\"schedule\"></tbody>\n        </table>\n      </div>\n    </section>\n  </section>\n</main>\n\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  const money = value => value.toLocaleString('en-US', {style:'currency', currency:'USD'});\n  const ns = 'http://www.w3.org/2000/svg';\n  let rows = [];\n  function svg(tag, attributes, text) {\n    const element = document.createElementNS(ns, tag);\n    Object.entries(attributes).forEach(([key, value]) => element.setAttribute(key, value));\n    if (text !== undefined) element.textContent = text;\n    return element;\n  }\n  function selectYear(value) {\n    $('year').value = value;\n    $('yearNumber').textContent = value;\n    const row = rows[value - 1];\n    if (!row) return;\n    $('yearDetail').textContent = `Year ${value}: ${money(row.principal)} principal + ${money(row.interest)} interest. Remaining balance: ${money(row.balance)}.`;\n    $('plot').querySelectorAll('[data-year]').forEach(bar => {\n      bar.setAttribute('opacity', Number(bar.dataset.year) === Number(value) ? '1' : '0.65');\n    });\n  }\n  function renderChart() {\n    const plot = $('plot');\n    plot.replaceChildren();\n    const left = 80, top = 20, width = 800, height = 265;\n    const max = Math.max(1, ...rows.map(row => row.principal + row.interest));\n    for (let i = 0; i <= 4; i++) {\n      const y = top + height - height * i / 4;\n      plot.append(svg('line', {x1:left,y1:y,x2:left+width,y2:y,stroke:'#888','stroke-opacity':'.25'}));\n      plot.append(svg('text', {x:left-8,y:y+4,'text-anchor':'end','font-size':12,fill:'currentColor'}, (max*i/4).toLocaleString('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0})));\n    }\n    const slot = width / rows.length;\n    rows.forEach((row, index) => {\n      const year = index + 1;\n      const x = left + index * slot + slot * .12;\n      const ph = row.principal / max * height;\n      const ih = row.interest / max * height;\n      const group = svg('g', {'data-year':year,tabindex:'0',role:'button','aria-label':`Year ${year}: principal ${money(row.principal)}, interest ${money(row.interest)}`});\n      group.append(svg('title', {}, `Year ${year}\\nPrincipal: ${money(row.principal)}\\nInterest: ${money(row.interest)}\\nBalance: ${money(row.balance)}`));\n      group.append(svg('rect',{x,y:top+height-ph,width:slot*.76,height:ph,fill:'#167d9a'}));\n      group.append(svg('rect',{x,y:top+height-ph-ih,width:slot*.76,height:ih,fill:'#a45116'}));\n      group.append(svg('rect',{x,y:top,width:slot*.76,height,fill:'transparent'}));\n      group.addEventListener('pointerenter', () => selectYear(year));\n      group.addEventListener('click', () => selectYear(year));\n      group.addEventListener('focus', () => selectYear(year));\n      group.addEventListener('keydown', event => {\n        if (event.key === 'Enter' || event.key === ' ') {\n          event.preventDefault();\n          selectYear(year);\n        }\n      });\n      plot.append(group);\n      if (year === 1 || year === rows.length || year % Math.ceil(rows.length/10) === 0) {\n        plot.append(svg('text',{x:left+(index+.5)*slot,y:305,'text-anchor':'middle','font-size':12,fill:'currentColor'},year));\n      }\n    });\n    plot.append(svg('text',{x:left+width/2,y:332,'text-anchor':'middle','font-size':13,fill:'currentColor'},'Year'));\n  }\n  function update() {\n    const fields = ['price','down','rate','term'].map($);\n    const [price, down, rate, years] = fields.map(field => field.valueAsNumber);\n    let error = '';\n    if (fields.some(field => !Number.isFinite(field.valueAsNumber))) error = 'Please enter a value in every field.';\n    else if (price < 0 || down < 0) error = 'Property price and down payment cannot be negative.';\n    else if (down > price) error = 'Down payment cannot exceed the property price.';\n    else if (rate < 0 || rate > 100) error = 'Enter an annual interest rate from 0% to 100%.';\n    else if (!Number.isInteger(years) || years < 1 || years > 100) error = 'Enter a whole-number term from 1 to 100 years.';\n    $('error').hidden = !error;\n    $('error').textContent = error;\n    $('results').hidden = !!error;\n    if (error) return;\n\n    const principal = price - down;\n    const r = rate / 100 / 12;\n    const n = years * 12;\n    const payment = r === 0 ? principal / n : principal * r / (-Math.expm1(-n * Math.log1p(r)));\n    rows = [];\n    let balance = principal, totalInterest = 0;\n    for (let year = 1; year <= years; year++) {\n      let annualInterest = 0, annualPrincipal = 0;\n      for (let month = 1; month <= 12; month++) {\n        const interest = balance * r;\n        const paidPrincipal = year === years && month === 12 ? balance : Math.min(balance, Math.max(0, payment - interest));\n        balance = Math.max(0, balance - paidPrincipal);\n        annualInterest += interest;\n        annualPrincipal += paidPrincipal;\n      }\n      totalInterest += annualInterest;\n      rows.push({interest:annualInterest,principal:annualPrincipal,balance});\n    }\n    $('principal').textContent = money(principal);\n    $('monthly').textContent = money(payment);\n    $('interest').textContent = money(totalInterest);\n    $('total').textContent = money(principal + totalInterest);\n    $('schedule').replaceChildren();\n    rows.forEach((row, index) => {\n      const tr = document.createElement('tr');\n      [index + 1, money(row.interest), money(row.principal), money(row.balance)].forEach((value, i) => {\n        const cell = document.createElement(i === 0 ? 'th' : 'td');\n        if (i === 0) cell.scope = 'row';\n        cell.textContent = value;\n        tr.append(cell);\n      });\n      $('schedule').append(tr);\n    });\n    const selected = Math.min(Number($('year').value), years);\n    $('year').max = years;\n    renderChart();\n    selectYear(selected);\n  }\n  ['price','down','rate','term'].forEach(id => $(id).addEventListener('input', update));\n  $('year').addEventListener('input', event => selectYear(Number(event.target.value)));\n  update();\n})();\n</script>",
