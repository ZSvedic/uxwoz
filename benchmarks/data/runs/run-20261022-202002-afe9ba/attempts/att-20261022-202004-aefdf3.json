nnual.length/10)) === 0) {\n        content.append(svg('text', {x:x+barWidth/2, y:300, 'text-anchor':'middle', fill:'currentColor', 'font-size':12}, index+1));\n      }\n    });\n    content.append(svg('text', {x:left+width/2, y:325, 'text-anchor':'middle', fill:'currentColor', 'font-size':13}, 'Year'));\n  }\n  function update() {\n    const price = Number($('price').value);\n    const down = Number($('down').value);\n    const rate = Number($('rate').value);\n    const years = Number($('years').value);\n    const valid = ['price','down','rate','years'].every(id => $(id).value.trim() !== '' && $(id).checkValidity())\n      && down <= price;\n    $('error').hidden = valid;\n    if (!valid) {\n      $('error').textContent = 'Enter nonnegative amounts, a down payment no greater than the property price, a rate from 0% to 100%, and a whole-number term from 1 to 100 years.';\n      ['principal','monthly','interest','total'].forEach(id => $(id).textContent = '\u2014');\n      annual = [];\n      bars = [];\n      $('schedule').replaceChildren();\n      $('chartContent').replaceChildren();\n      $('yearDetail').textContent = '';\n      $('selectedYear').disabled = true;\n      return;\n    }\n    const principal = price - down;\n    const r = rate / 100 / 12;\n    const months = years * 12;\n    const payment = r === 0 ? principal / months : principal * r / (-Math.expm1(-months * Math.log1p(r)));\n    let balance = principal;\n    let totalInterest = 0;\n    annual = [];\n    for (let year = 1; year <= years; year++) {\n      let interestPaid = 0, principalPaid = 0;\n      for (let month = 0; month < 12; month++) {\n        const interest = balance * r;\n        const paid = year === years && month === 11 ? balance : Math.min(balance, Math.max(0, payment - interest));\n        balance = Math.max(0, balance - paid);\n        interestPaid += interest;\n        principalPaid += paid;\n      }\n      totalInterest += interestPaid;\n      annual.push({interest:interestPaid, principal:principalPaid, balance});\n    }\n    $('principal').textContent = money(principal);\n    $('monthly').textContent = money(payment);\n    $('interest').textContent = money(totalInterest);\n    $('total').textContent = money(principal + totalInterest);\n    const rows = document.createDocumentFragment();\n    annual.forEach((row, index) => {\n      const tr = document.createElement('tr');\n      [index+1, money(row.interest), money(row.principal), money(row.balance)].forEach((value, i) => {\n        const cell = document.createElement(i === 0 ? 'th' : 'td');\n        if (i === 0) cell.scope = 'row';\n        cell.textContent = value;\n        tr.append(cell);\n      });\n      rows.append(tr);\n    });\n    $('schedule').replaceChildren(rows);\n    $('selectedYear').disabled = false;\n    const selected = Math.min(Number($('selectedYear').value), years);\n    $('selectedYear').max = years;\n    drawChart();\n    selectYear(selected);\n  }\n  ['price','down','rate','years'].forEach(id => $(id).addEventListener('input', update));\n  $('selectedYear').addEventListener('input', event => selectYear(event.target.value));\n  update();\n})();\n</script>",
