  "extractedSource": "<main>\n  <header>\n    <h1>Mortgage calculator</h1>\n    <p>Explore your monthly payment and how your mortgage balance changes over time.</p>\n  </header>\n\n  <section aria-label=\"Mortgage inputs\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\">\n    <label for=\"price\">Property price ($)\n      <input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"down\">Down payment ($)\n      <input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"rate\">Annual interest rate (%)\n      <input id=\"rate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"6.5\" inputmode=\"decimal\">\n    </label>\n    <label for=\"years\">Term (years)\n      <input id=\"years\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" value=\"30\" inputmode=\"numeric\">\n    </label>\n  </section>\n\n  <p id=\"error\" role=\"alert\" hidden></p>\n\n  <section aria-label=\"Payment summary\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\" aria-live=\"polite\">\n    <article><small>Loan principal</small><h2 id=\"principal\">\u2014</h2></article>\n    <article><small>Monthly payment</small><h2 id=\"monthly\">\u2014</h2></article>\n    <article><small>Total interest</small><h2 id=\"interest\">\u2014</h2></article>\n    <article><small>Total loan payments</small><h2 id=\"total\">\u2014</h2></article>\n  </section>\n  <p><small>Principal and interest only. Excludes property taxes, insurance, HOA fees and closing costs. Total loan payments exclude the down payment. Calculations use unrounded payments; displayed amounts are rounded.</small></p>\n\n  <article>\n    <h2>Annual principal and interest</h2>\n    <p><span style=\"color:#167570\">\u25cf</span> Principal paid &nbsp; <span style=\"color:#ac4b16\">\u25cf</span> Interest paid</p>\n    <p><small>Select a year below or point to a bar to explore its breakdown.</small></p>\n    <label for=\"selectedYear\">Year to explore\n      <input id=\"selectedYear\" type=\"range\" min=\"1\" max=\"30\" value=\"1\" step=\"1\">\n    </label>\n    <p id=\"yearDetail\" aria-live=\"polite\"></p>\n    <svg id=\"chart\" viewBox=\"0 0 900 330\" role=\"img\" aria-labelledby=\"chartTitle chartDescription\" style=\"display:block;width:100%;height:auto\">\n      <title id=\"chartTitle\">Annual mortgage payment breakdown</title>\n      <desc id=\"chartDescription\">Stacked bars show the principal and interest paid each year. The same values are available in the annual table.</desc>\n      <g id=\"chartContent\"></g>\n    </svg>\n  </article>\n\n  <section>\n    <h2>Annual amortization schedule</h2>\n    <div style=\"overflow-x:auto\">\n      <table>\n        <caption>Payments and remaining balance at the end of each year</caption>\n        <thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Interest paid</th><th scope=\"col\">Principal paid</th><th scope=\"col\">Remaining balance</th></tr></thead>\n        <tbody id=\"schedule\"></tbody>\n      </table>\n    </div>\n  </section>\n</main>\n\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  const money = value => value.toLocaleString('en-US', {style:'currency', currency:'USD'});\n  const ns = 'http://www.w3.org/2000/svg';\n  let annual = [];\n  let bars = [];\n  function svg(tag, attrs, text) {\n    const node = document.createElementNS(ns, tag);\n    Object.entries(attrs).forEach(([key, value]) => node.setAttribute(key, value));\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n  function selectYear(value) {\n    if (!annual.length) return;\n    const year = Math.max(1, Math.min(annual.length, Number(value)));\n    $('selectedYear').value = year;\n    const row = annual[year - 1];\n    $('yearDetail').textContent = `Year ${year}: ${money(row.principal)} principal \u00b7 ${money(row.interest)} interest \u00b7 ${money(row.balance)} remaining`;\n    bars.forEach((bar, i) => {\n      bar.setAttribute('opacity', i === year - 1 ? '1' : '0.7');\n      bar.setAttribute('stroke', i === year - 1 ? 'currentColor' : 'none');\n    });\n  }\n  function drawChart() {\n    const content = $('chartContent');\n    content.replaceChildren();\n    bars = [];\n    const left = 85, top = 20, width = 790, height = 260;\n    const maximum = Math.max(1, ...annual.map(row => row.principal + row.interest));\n    for (let i = 0; i <= 4; i++) {\n      const y = top + height - height * i / 4;\n      content.append(svg('line', {x1:left, x2:left+width, y1:y, y2:y, stroke:'currentColor', opacity:0.15}));\n      content.append(svg('text', {x:left-10, y:y+4, 'text-anchor':'end', fill:'currentColor', 'font-size':12},\n        (maximum * i / 4).toLocaleString('en-US', {style:'currency', currency:'USD', maximumFractionDigits:0})));\n    }\n    const slot = width / annual.length;\n    annual.forEach((row, index) => {\n      const group = svg('g', {'stroke-width':1.5});\n      const x = left + index * slot + slot * 0.12;\n      const barWidth = slot * 0.76;\n      const ph = row.principal / maximum * height;\n      const ih = row.interest / maximum * height;\n      group.append(svg('title', {}, `Year ${index+1}: principal ${money(row.principal)}, interest ${money(row.interest)}, balance ${money(row.balance)}`));\n      group.append(svg('rect', {x, y:top+height-ph, width:barWidth, height:ph, fill:'#167570'}));\n      group.append(svg('rect', {x, y:top+height-ph-ih, width:barWidth, height:ih, fill:'#ac4b16'}));\n      group.append(svg('rect', {x, y:top, width:barWidth, height, fill:'transparent', stroke:'none'}));\n      group.addEventListener('pointerenter', () => selectYear(index+1));\n      group.addEventListener('click', () => selectYear(index+1));\n      content.append(group);\n      bars.push(group);\n      if (index === 0 || index === annual.length-1 || (index+1) % Math.max(1, Math.ceil(annual.length/10)) === 0) {\n        content.append(svg('text', {x:x+barWidth/2, y:300, 'text-anchor':'middle', fill:'currentColor', 'font-size':12}, index+1));\n      }\n    });\n    content.append(svg('text', {x:left+width/2, y:325, 'text-anchor':'middle', fill:'currentColor', 'font-size':13}, 'Year'));\n  }\n  function update() {\n    const price = Number($('price').value);\n    const down = Number($('down').value);\n    const rate = Number($('rate').value);\n    const years = Number($('years').value);\n    const valid = ['price','down','rate','years'].every(id => $(id).value.trim() !== '' && $(id).checkValidity())\n      && down <= price;\n    $('error').hidden = valid;\n    if (!valid) {\n      $('error').textContent = 'Enter nonnegative amounts, a down payment no greater than the property price, a rate from 0% to 100%, and a whole-number term from 1 to 100 years.';\n      ['principal','monthly','interest','total'].forEach(id => $(id).textContent = '\u2014');\n      annual = [];\n      bars = [];\n      $('schedule').replaceChildren();\n      $('chartContent').replaceChildren();\n      $('yearDetail').textContent = '';\n      $('selectedYear').disabled = true;\n      return;\n    }\n    const principal = price - down;\n    const r = rate / 100 / 12;\n    const months = years * 12;\n    const payment = r === 0 ? principal / months : principal * r / (-Math.expm1(-months * Math.log1p(r)));\n    let balance = principal;\n    let totalInterest = 0;\n    annual = [];\n    for (let year = 1; year <= years; year++) {\n      let interestPaid = 0, principalPaid = 0;\n      for (let month = 0; month < 12; month++) {\n        const interest = balance * r;\n        const paid = year === years && month === 11 ? balance : Math.min(balance, Math.max(0, payment - interest));\n        balance = Math.max(0, balance - paid);\n        interestPaid += interest;\n        principalPaid += paid;\n      }\n      totalInterest += interestPaid;\n      annual.push({interest:interestPaid, principal:principalPaid, balance});\n    }\n    $('principal').textContent = money(principal);\n    $('monthly').textContent = money(payment);\n    $('interest').textContent = money(totalInterest);\n    $('total').textContent = money(principal + totalInterest);\n    const rows = document.createDocumentFragment();\n    annual.forEach((row, index) => {\n      const tr = document.createElement('tr');\n      [index+1, money(row.interest), money(row.principal), money(row.balance)].forEach((value, i) => {\n        const cell = document.createElement(i === 0 ? 'th' : 'td');\n        if (i === 0) cell.scope = 'row';\n        cell.textContent = value;\n        tr.append(cell);\n      });\n      rows.append(tr);\n    });\n    $('schedule').replaceChildren(rows);\n    $('selectedYear').disabled = false;\n    const selected = Math.min(Number($('selectedYear').value), years);\n    $('selectedYear').max = years;\n    drawChart();\n    selectYear(selected);\n  }\n  ['price','down','rate','years'].forEach(id => $(id).addEventListener('input', update));\n  $('selectedYear').addEventListener('input', event => selectYear(event.target.value));\n  update();\n})();\n</script>",
