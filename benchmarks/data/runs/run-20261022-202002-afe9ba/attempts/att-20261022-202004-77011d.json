  "extractedSource": "<main>\n  <h1>Mortgage calculator</h1>\n  <p>Estimate your fixed-rate mortgage payment and see how your loan is paid down over time.</p>\n\n  <section aria-label=\"Mortgage inputs\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\">\n    <label for=\"price\">Property price ($)\n      <input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"down\">Down payment ($)\n      <input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"rate\">Annual interest rate (%)\n      <input id=\"rate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"6.5\" inputmode=\"decimal\">\n    </label>\n    <label for=\"term\">Term (years)\n      <input id=\"term\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" value=\"30\" inputmode=\"numeric\">\n    </label>\n  </section>\n\n  <p id=\"error\" role=\"alert\" hidden></p>\n\n  <section id=\"results\" aria-label=\"Mortgage summary\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\" aria-live=\"polite\">\n    <article><header>Loan principal</header><h2 id=\"principal\"></h2></article>\n    <article><header>Monthly payment</header><h2 id=\"monthly\"></h2><small>Principal and interest only</small></article>\n    <article><header>Total interest</header><h2 id=\"interest\"></h2></article>\n    <article><header>Total loan payments</header><h2 id=\"total\"></h2><small>Does not include your down payment</small></article>\n  </section>\n\n  <section id=\"schedule\">\n    <h2>Annual amortization</h2>\n    <p>Each stacked bar shows principal and interest paid that year. Point to, tap, or focus a bar to explore.</p>\n    <p><span style=\"color:#1971c2\">\u25cf</span> Principal paid &nbsp; <span style=\"color:#b45309\">\u25cf</span> Interest paid</p>\n    <svg id=\"chart\" viewBox=\"0 0 900 320\" width=\"900\" style=\"width:100%;height:auto\" role=\"group\" aria-label=\"Annual principal and interest paid\"></svg>\n    <label for=\"year\">Explore year <output id=\"yearLabel\" for=\"year\">1</output>\n      <input id=\"year\" type=\"range\" min=\"1\" max=\"30\" value=\"1\" step=\"1\">\n    </label>\n    <p id=\"detail\" aria-live=\"polite\"></p>\n\n    <div style=\"overflow-x:auto\">\n      <table>\n        <caption>Yearly payments and remaining loan balance</caption>\n        <thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Interest paid</th><th scope=\"col\">Principal paid</th><th scope=\"col\">Remaining balance</th></tr></thead>\n        <tbody id=\"rows\"></tbody>\n      </table>\n    </div>\n  </section>\n  <p><small>Estimates assume equal monthly payments and a constant interest rate. Taxes, insurance, HOA fees, closing costs, and extra payments are excluded. Calculations use unrounded payments; displayed amounts are rounded to cents.</small></p>\n</main>\n\n<script>\n(() => {\n  const get = id => document.getElementById(id);\n  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });\n  const fmt = value => money.format(value);\n  const ns = 'http://www.w3.org/2000/svg';\n  let annual = [];\n  function svgElement(tag, attributes, text) {\n    const node = document.createElementNS(ns, tag);\n    Object.entries(attributes).forEach(([key, value]) => node.setAttribute(key, value));\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n  function selectYear(value) {\n    const index = Math.max(0, Math.min(annual.length - 1, Number(value) - 1));\n    const item = annual[index];\n    if (!item) return;\n    get('year').value = index + 1;\n    get('yearLabel').textContent = index + 1;\n    get('detail').textContent = `Year ${index + 1}: ${fmt(item.principal)} principal + ${fmt(item.interest)} interest. Remaining balance: ${fmt(item.balance)}.`;\n    get('chart').querySelectorAll('[data-year]').forEach(node => {\n      node.setAttribute('opacity', Number(node.dataset.year) === index + 1 ? '1' : '0.65');\n    });\n  }\n  function renderChart() {\n    const chart = get('chart');\n    chart.replaceChildren();\n    const left = 85, top = 20, width = 795, height = 250;\n    const max = Math.max(1, ...annual.map(item => item.principal + item.interest));\n    for (let i = 0; i <= 4; i++) {\n      const y = top + height - height * i / 4;\n      chart.append(svgElement('line', { x1: left, x2: left + width, y1: y, y2: y, stroke: 'currentColor', 'stroke-opacity': '0.15' }));\n      chart.append(svgElement('text', { x: left - 8, y: y + 4, 'text-anchor': 'end', fill: 'currentColor', 'font-size': 12 }, new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(max * i / 4)));\n    }\n    const slot = width / annual.length;\n    annual.forEach((item, index) => {\n      const group = svgElement('g', { tabindex: '0', role: 'button', 'data-year': index + 1, 'aria-label': `Year ${index + 1}: principal ${fmt(item.principal)}, interest ${fmt(item.interest)}, remaining balance ${fmt(item.balance)}` });\n      const x = left + slot * index + slot * 0.1;\n      const pHeight = item.principal / max * height;\n      const iHeight = item.interest / max * height;\n      group.append(svgElement('title', {}, group.getAttribute('aria-label')));\n      group.append(svgElement('rect', { x, y: top, width: slot * 0.8, height, fill: 'transparent' }));\n      group.append(svgElement('rect', { x, y: top + height - pHeight, width: slot * 0.8, height: pHeight, fill: '#1971c2' }));\n      group.append(svgElement('rect', { x, y: top + height - pHeight - iHeight, width: slot * 0.8, height: iHeight, fill: '#b45309' }));\n      ['pointerenter', 'click', 'focus'].forEach(event => group.addEventListener(event, () => selectYear(index + 1)));\n      group.addEventListener('keydown', event => {\n        if (event.key === 'Enter' || event.key === ' ') {\n          event.preventDefault();\n          selectYear(index + 1);\n        }\n      });\n      chart.append(group);\n      if (index === 0 || index === annual.length - 1 || (index + 1) % Math.max(1, Math.ceil(annual.length / 10)) === 0) {\n        chart.append(svgElement('text', { x: left + slot * (index + 0.5), y: 290, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 12 }, index + 1));\n      }\n    });\n    chart.append(svgElement('text', { x: left + width / 2, y: 315, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': 13 }, 'Loan year'));\n  }\n  function update() {\n    const fields = ['price', 'down', 'rate', 'term'].map(get);\n    const [price, down, rate, years] = fields.map(field => field.valueAsNumber);\n    const valid = fields.every(field => field.value !== '' && field.checkValidity() && Number.isFinite(field.valueAsNumber)) && down <= price;\n    get('error').hidden = valid;\n    get('results').hidden = !valid;\n    get('results').style.display = valid ? 'grid' : 'none';\n    get('schedule').hidden = !valid;\n    if (!valid) {\n      get('error').textContent = 'Enter nonnegative amounts, a down payment no greater than the property price, a rate from 0% to 100%, and a whole-number term from 1 to 100 years.';\n      return;\n    }\n    const principal = price - down;\n    const r = rate / 100 / 12;\n    const n = years * 12;\n    const payment = r === 0 ? principal / n : principal * r / (-Math.expm1(-n * Math.log1p(r)));\n    annual = [];\n    let balance = principal, totalInterest = 0, totalPaid = 0;\n    for (let y = 1; y <= years; y++) {\n      let interest = 0, paidPrincipal = 0;\n      for (let month = 0; month < 12; month++) {\n        const interestPart = balance * r;\n        const principalPart = y === years && month === 11 ? balance : Math.min(balance, Math.max(0, payment - interestPart));\n        interest += interestPart;\n        paidPrincipal += principalPart;\n        balance = Math.max(0, balance - principalPart);\n      }\n      totalInterest += interest;\n      totalPaid += interest + paidPrincipal;\n      annual.push({ interest, principal: paidPrincipal, balance });\n    }\n    get('principal').textContent = fmt(principal);\n    get('monthly').textContent = fmt(payment);\n    get('interest').textContent = fmt(totalInterest);\n    get('total').textContent = fmt(totalPaid);\n    const fragment = document.createDocumentFragment();\n    annual.forEach((item, index) => {\n      const row = document.createElement('tr');\n      [index + 1, fmt(item.interest), fmt(item.principal), fmt(item.balance)].forEach((value, column) => {\n        const cell = document.createElement(column === 0 ? 'th' : 'td');\n        if (column === 0) cell.scope = 'row';\n        cell.textContent = value;\n        row.append(cell);\n      });\n      fragment.append(row);\n    });\n    get('rows').replaceChildren(fragment);\n    get('year').max = years;\n    renderChart();\n    selectYear(get('year').value);\n  }\n  ['price', 'down', 'rate', 'term'].forEach(id => get(id).addEventListener('input', update));\n  get('year').addEventListener('input', event => selectYear(event.target.value));\n  update();\n})();\n</script>",
