 "source": "<section aria-labelledby=\"mortgage-title\">\n  <h1 id=\"mortgage-title\">Mortgage calculator</h1>\n  <p>Estimate your fixed-rate mortgage payments and see how your balance falls over time.</p>\n\n  <fieldset style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;\">\n    <label for=\"price\">Property price ($)\n      <input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"down\">Down payment ($)\n      <input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"rate\">Annual interest rate (%)\n      <input id=\"rate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"6.5\" inputmode=\"decimal\">\n    </label>\n    <label for=\"term\">Term (years)\n      <input id=\"term\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" value=\"30\" inputmode=\"numeric\">\n    </label>\n  </fieldset>\n\n  <p id=\"error\" role=\"alert\" hidden></p>\n\n  <div id=\"results\">\n    <section aria-label=\"Payment summary\" style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1rem;\" aria-live=\"polite\">\n      <article><small>Loan principal</small><h2 id=\"principal\"></h2></article>\n      <article><small>Monthly payment</small><h2 id=\"monthly\"></h2></article>\n      <article><small>Total interest</small><h2 id=\"interest\"></h2></article>\n      <article><small>Total payments</small><h2 id=\"total\"></h2></article>\n    </section>\n\n    <small>Principal and interest only. Excludes property taxes, insurance, mortgage insurance, and fees. Calculations use unrounded monthly payments.</small>\n\n    <article>\n      <h2>Annual principal and interest</h2>\n      <p><span style=\"color: #167d9a;\">\u25a0 Principal</span> &nbsp; <span style=\"color: #a94f16;\">\u25a0 Interest</span></p>\n      <p><small>Hover over a bar, select a bar, or use the year control to explore annual payments.</small></p>\n      <svg id=\"chart\" viewBox=\"0 0 900 320\" width=\"100%\" role=\"img\" aria-labelledby=\"chart-title chart-description\">\n        <title id=\"chart-title\">Annual mortgage payments</title>\n        <desc id=\"chart-description\">Stacked bars show principal and interest paid each year.</desc>\n      </svg>\n      <label for=\"year\">Explore year <output id=\"selected-year\" for=\"year\">1</output>\n        <input id=\"year\" type=\"range\" min=\"1\" max=\"30\" step=\"1\" value=\"1\">\n      </label>\n      <p id=\"year-detail\" aria-live=\"polite\"></p>\n    </article>\n\n    <h2>Annual amortization schedule</h2>\n    <div style=\"overflow-x: auto;\">\n      <table>\n        <caption>Payments and remaining balance by year</caption>\n        <thead>\n          <tr><th scope=\"col\">Year</th><th scope=\"col\">Interest paid</th><th scope=\"col\">Principal paid</th><th scope=\"col\">Remaining balance</th></tr>\n        </thead>\n        <tbody id=\"schedule\"></tbody>\n      </table>\n    </div>\n  </div>\n</section>\n\n<script>\n(() => {\n  const el = id => document.getElementById(id);\n  const money = value => value.toLocaleString('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  const ns = 'http://www.w3.org/2000/svg';\n  let years = [];\n  let bars = [];\n  function svgNode(tag, attributes, text) {\n    const node = document.createElementNS(ns, tag);\n    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n  function selectYear(value) {\n    const index = Math.max(0, Math.min(years.length - 1, Number(value) - 1));\n    const row = years[index];\n    if (!row) return;\n    el('year').value = index + 1;\n    el('selected-year').textContent = index + 1;\n    el('year-detail').textContent = `Year ${index + 1}: ${money(row.principal)} principal \u2022 ${money(row.interest)} interest \u2022 ${money(row.balance)} remaining`;\n    bars.forEach((bar, i) => {\n      bar.setAttribute('opacity', i === index ? '1' : '0.7');\n      bar.setAttribute('stroke', i === index ? 'currentColor' : 'none');\n      bar.setAttribute('stroke-width', '2');\n    });\n  }\n  function drawChart() {\n    const chart = el('chart');\n    chart.querySelectorAll('g').forEach(node => node.remove());\n    const group = svgNode('g', {});\n    chart.appendChild(group);\n    const left = 85, top = 20, width = 795, height = 245;\n    const max = Math.max(1, ...years.map(row => row.principal + row.interest));\n    for (let tick = 0; tick <= 4; tick++) {\n      const value = max * tick / 4;\n      const y = top + height - height * tick / 4;\n      group.appendChild(svgNode('line', { x1: left, x2: left + width, y1: y, y2: y, stroke: 'currentColor', opacity: '0.15' }));\n      group.appendChild(svgNode('text', { x: left - 8, y: y + 4, 'text-anchor': 'end', fill: 'currentColor', 'font-size': '12' }, '$' + Math.round(value).toLocaleString('en-US')));\n    }\n    bars = [];\n    const slot = width / years.length;\n    years.forEach((row, index) => {\n      const bar = svgNode('g', { cursor: 'pointer' });\n      const x = left + index * slot + slot * 0.12;\n      const ph = row.principal / max * height;\n      const ih = row.interest / max * height;\n      bar.appendChild(svgNode('title', {}, `Year ${index + 1}: principal ${money(row.principal)}, interest ${money(row.interest)}, remaining ${money(row.balance)}`));\n      bar.appendChild(svgNode('rect', { x, y: top + height - ph, width: slot * 0.76, height: ph, fill: '#167d9a' }));\n      bar.appendChild(svgNode('rect', { x, y: top + height - ph - ih, width: slot * 0.76, height: ih, fill: '#a94f16' }));\n      bar.appendChild(svgNode('rect', { x, y: top, width: slot * 0.76, height, fill: 'transparent', stroke: 'none' }));\n      bar.addEventListener('pointerenter', () => selectYear(index + 1));\n      bar.addEventListener('click', () => selectYear(index + 1));\n      group.appendChild(bar);\n      bars.push(bar);\n      const interval = Math.max(1, Math.ceil(years.length / 12));\n      if (index === 0 || (index + 1) % interval === 0 || index === years.length - 1) {\n        group.appendChild(svgNode('text', { x: left + (index + 0.5) * slot, y: top + height + 22, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': '12' }, index + 1));\n      }\n    });\n    group.appendChild(svgNode('text', { x: left + width / 2, y: 312, 'text-anchor': 'middle', fill: 'currentColor', 'font-size': '13' }, 'Loan year'));\n  }\n  function update() {\n    const inputs = ['price', 'down', 'rate', 'term'].map(el);\n    const [price, down, rate, term] = inputs.map(input => input.valueAsNumber);\n    let error = '';\n    if (inputs.some(input => !Number.isFinite(input.valueAsNumber))) error = 'Enter a number in every field.';\n    else if (price < 0 || down < 0) error = 'Property price and down payment cannot be negative.';\n    else if (down > price) error = 'Down payment cannot exceed the property price.';\n    else if (rate < 0 || rate > 100) error = 'Enter an interest rate between 0% and 100%.';\n    else if (!Number.isInteger(term) || term < 1 || term > 100) error = 'Enter a whole-number term between 1 and 100 years.';\n    el('error').textContent = error;\n    el('error').hidden = !error;\n    el('results').hidden = !!error;\n    if (error) return;\n\n    const principal = price - down;\n    const r = rate / 100 / 12;\n    const n = term * 12;\n    const payment = r === 0 ? principal / n : principal * r / (-Math.expm1(-n * Math.log1p(r)));\n    let balance = principal, totalInterest = 0;\n    years = [];\n    for (let year = 1; year <= term; year++) {\n      let interest = 0, paidPrincipal = 0;\n      for (let month = 0; month < 12; month++) {\n        const monthlyInterest = balance * r;\n        const paid = year === term && month === 11 ? balance : Math.min(balance, Math.max(0, payment - monthlyInterest));\n        interest += monthlyInterest;\n        paidPrincipal += paid;\n        balance = Math.max(0, balance - paid);\n      }\n      totalInterest += interest;\n      years.push({ interest, principal: paidPrincipal, balance });\n    }\n    el('principal').textContent = money(principal);\n    el('monthly').textContent = money(payment);\n    el('interest').textContent = money(totalInterest);\n    el('total').textContent = money(principal + totalInterest);\n    const fragment = document.createDocumentFragment();\n    years.forEach((row, index) => {\n      const tr = document.createElement('tr');\n      [index + 1, money(row.interest), money(row.principal), money(row.balance)].forEach((value, column) => {\n        const cell = document.createElement(column === 0 ? 'th' : 'td');\n        if (column === 0) cell.scope = 'row';\n        cell.textContent = value;\n        tr.appendChild(cell);\n      });\n      fragment.appendChild(tr);\n    });\n    el('schedule').replaceChildren(fragment);\n    el('year').max = term;\n    drawChart();\n    selectYear(el('year').value);\n  }\n  ['price', 'down', 'rate', 'term'].forEach(id => el(id).addEventListener('input', update));\n  el('year').addEventListener('input', event => selectYear(event.target.value));\n  update();\n})();\n</script>",
