 "source": "<main>\n  <h1>Mortgage calculator</h1>\n  <p>Estimate your fixed-rate mortgage payments and see how your balance changes over time.</p>\n\n  <section aria-label=\"Mortgage inputs\" style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1rem\">\n    <label for=\"price\">Property price ($)\n      <input id=\"price\" type=\"number\" min=\"0\" step=\"1000\" value=\"400000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"down\">Down payment ($)\n      <input id=\"down\" type=\"number\" min=\"0\" step=\"1000\" value=\"80000\" inputmode=\"decimal\">\n    </label>\n    <label for=\"rate\">Annual interest rate (%)\n      <input id=\"rate\" type=\"number\" min=\"0\" max=\"100\" step=\"0.01\" value=\"6.5\" inputmode=\"decimal\">\n    </label>\n    <label for=\"term\">Term (years)\n      <input id=\"term\" type=\"number\" min=\"1\" max=\"100\" step=\"1\" value=\"30\" inputmode=\"numeric\">\n    </label>\n  </section>\n  <p id=\"error\" role=\"alert\" hidden></p>\n\n  <section id=\"results\" aria-label=\"Mortgage results\">\n    <div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:1rem\" aria-live=\"polite\">\n      <article><header>Loan principal</header><h2 id=\"principal\"></h2></article>\n      <article><header>Monthly payment</header><h2 id=\"monthly\"></h2></article>\n      <article><header>Total interest</header><h2 id=\"interest\"></h2></article>\n      <article><header>Total payment</header><h2 id=\"total\"></h2></article>\n    </div>\n    <p><small>Principal and interest only. Excludes taxes, insurance, fees and mortgage insurance. Total payment excludes your down payment. Calculations use unrounded monthly payments.</small></p>\n\n    <article>\n      <h2>Annual payment breakdown</h2>\n      <p><span style=\"color:#2474b5\">\u25cf</span> Principal paid &nbsp; <span style=\"color:#bc5617\">\u25cf</span> Interest paid</p>\n      <label for=\"selectedYear\">Explore year <output id=\"yearNumber\" for=\"selectedYear\">1</output>\n        <input id=\"selectedYear\" type=\"range\" min=\"1\" max=\"30\" value=\"1\" step=\"1\">\n      </label>\n      <p id=\"yearDetails\" aria-live=\"polite\"></p>\n      <svg id=\"chart\" viewBox=\"0 0 900 340\" role=\"img\" aria-labelledby=\"chartTitle chartDescription\" style=\"width:100%;height:auto\">\n        <title id=\"chartTitle\">Annual principal and interest payments</title>\n        <desc id=\"chartDescription\">Stacked bars show principal and interest paid each year. Select a bar or use the year slider to explore.</desc>\n      </svg>\n      <small>Select a bar, use the year slider, or focus a bar and press Enter to explore a year.</small>\n    </article>\n\n    <h2>Annual amortization schedule</h2>\n    <div style=\"overflow-x:auto\">\n      <table>\n        <caption>Payments and remaining loan balance by year</caption>\n        <thead><tr><th scope=\"col\">Year</th><th scope=\"col\">Interest paid</th><th scope=\"col\">Principal paid</th><th scope=\"col\">Remaining balance</th></tr></thead>\n        <tbody id=\"schedule\"></tbody>\n      </table>\n    </div>\n  </section>\n</main>\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  const money = value => value.toLocaleString('en-US', {style:'currency', currency:'USD'});\n  const fields = ['price','down','rate','term'].map($);\n  const slider = $('selectedYear');\n  const svg = $('chart');\n  const ns = 'http://www.w3.org/2000/svg';\n  let years = [];\n  let bars = [];\n  function node(tag, attrs, text) {\n    const el = document.createElementNS(ns, tag);\n    Object.entries(attrs || {}).forEach(([key,value]) => el.setAttribute(key,value));\n    if (text !== undefined) el.textContent = text;\n    return el;\n  }\n  function selectYear(value) {\n    const index = Math.max(0, Math.min(years.length - 1, Number(value) - 1));\n    slider.value = index + 1;\n    $('yearNumber').textContent = index + 1;\n    const row = years[index];\n    if (!row) return;\n    $('yearDetails').textContent = `Year ${index + 1}: ${money(row.principal)} principal \u00b7 ${money(row.interest)} interest \u00b7 ${money(row.balance)} remaining`;\n    bars.forEach((bar,i) => {\n      bar.setAttribute('stroke', i === index ? 'currentColor' : 'none');\n      bar.setAttribute('stroke-width', i === index ? '2' : '0');\n      bar.setAttribute('aria-pressed', String(i === index));\n    });\n  }\n  function draw() {\n    while (svg.children.length > 2) svg.lastChild.remove();\n    bars = [];\n    const left = 85, top = 20, width = 795, height = 265;\n    const max = Math.max(1, ...years.map(y => y.principal + y.interest));\n    for (let i = 0; i <= 4; i++) {\n      const y = top + height - height * i / 4;\n      svg.append(node('line',{x1:left,y1:y,x2:left+width,y2:y,stroke:'currentColor','stroke-opacity':'.15'}));\n      svg.append(node('text',{x:left-10,y:y+4,'text-anchor':'end',fill:'currentColor','font-size':12},money(max*i/4)));\n    }\n    const step = width / years.length;\n    years.forEach((row,i) => {\n      const x = left + i * step + step * .12;\n      const w = step * .76;\n      const ph = row.principal / max * height;\n      const ih = row.interest / max * height;\n      const g = node('g',{tabindex:'0',role:'button','aria-label':`Year ${i+1}: principal ${money(row.principal)}, interest ${money(row.interest)}, remaining ${money(row.balance)}`,style:'cursor:pointer'});\n      g.append(node('title',{},`Year ${i+1}\\nPrincipal: ${money(row.principal)}\\nInterest: ${money(row.interest)}\\nBalance: ${money(row.balance)}`));\n      g.append(node('rect',{x,y:top,width:w,height,fill:'transparent',stroke:'none'}));\n      g.append(node('rect',{x,y:top+height-ph,width:w,height:ph,fill:'#2474b5'}));\n      g.append(node('rect',{x,y:top+height-ph-ih,width:w,height:ih,fill:'#bc5617'}));\n      g.addEventListener('click',() => selectYear(i+1));\n      g.addEventListener('keydown', e => {\n        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectYear(i+1); }\n      });\n      svg.append(g);\n      bars.push(g);\n      const interval = Math.max(1,Math.ceil(years.length/15));\n      if (i === 0 || (i+1)%interval === 0 || i === years.length-1) {\n        svg.append(node('text',{x:x+w/2,y:306,'text-anchor':'middle',fill:'currentColor','font-size':12},i+1));\n      }\n    });\n    svg.append(node('text',{x:left+width/2,y:332,'text-anchor':'middle',fill:'currentColor','font-size':13},'Year'));\n    selectYear(slider.value);\n  }\n  function calculate() {\n    const [price,down,rate,term] = fields.map(el => el.valueAsNumber);\n    let error = '';\n    if (fields.some(el => el.value === '' || !Number.isFinite(el.valueAsNumber))) error = 'Enter a valid number in every field.';\n    else if (price < 0 || down < 0) error = 'Property price and down payment cannot be negative.';\n    else if (down > price) error = 'Down payment cannot exceed the property price.';\n    else if (rate < 0 || rate > 100) error = 'Enter an annual interest rate from 0% to 100%.';\n    else if (!Number.isInteger(term) || term < 1 || term > 100) error = 'Enter a whole-number term from 1 to 100 years.';\n    $('error').hidden = !error;\n    $('error').textContent = error;\n    $('results').hidden = !!error;\n    if (error) return;\n    const principal = price-down;\n    const r = rate/100/12;\n    const n = term*12;\n    const payment = r === 0 ? principal/n : principal*r / (-Math.expm1(-n*Math.log1p(r)));\n    years = [];\n    let balance = principal;\n    let totalInterest = 0;\n    for (let year=1; year<=term; year++) {\n      let interestPaid=0, principalPaid=0;\n      for (let month=1; month<=12; month++) {\n        const interest = balance*r;\n        const paidPrincipal = year === term && month === 12 ? balance : Math.min(balance,Math.max(0,payment-interest));\n        balance = Math.max(0,balance-paidPrincipal);\n        interestPaid += interest;\n        principalPaid += paidPrincipal;\n      }\n      totalInterest += interestPaid;\n      years.push({interest:interestPaid,principal:principalPaid,balance});\n    }\n    $('principal').textContent = money(principal);\n    $('monthly').textContent = money(payment);\n    $('interest').textContent = money(totalInterest);\n    $('total').textContent = money(principal+totalInterest);\n    $('schedule').replaceChildren();\n    const fragment = document.createDocumentFragment();\n    years.forEach((row,i) => {\n      const tr = document.createElement('tr');\n      [i+1,money(row.interest),money(row.principal),money(row.balance)].forEach((value,j) => {\n        const cell = document.createElement(j === 0 ? 'th' : 'td');\n        if (j === 0) cell.scope = 'row';\n        cell.textContent = value;\n        tr.append(cell);\n      });\n      fragment.append(tr);\n    });\n    $('schedule').append(fragment);\n    slider.max = term;\n    draw();\n  }\n  fields.forEach(el => el.addEventListener('input',calculate));\n  slider.addEventListener('input',() => selectYear(slider.value));\n  calculate();\n})();\n</script>",
