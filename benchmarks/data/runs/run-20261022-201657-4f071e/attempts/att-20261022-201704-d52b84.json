  "extractedSource": "<section aria-labelledby=\"mortgage-heading\">\n  <h1 id=\"mortgage-heading\">Mortgage calculator</h1>\n  <p>Estimate your fixed-rate mortgage payment and see how your balance falls over time.</p>\n\n  <div style=\"display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem;\">\n    <article>\n      <h2>Loan details</h2>\n      <label for=\"price\">Property price ($)</label>\n      <input id=\"price\" type=\"number\" value=\"400000\" min=\"0\" max=\"1000000000\" step=\"1000\" inputmode=\"decimal\">\n      <label for=\"down\">Down payment ($)</label>\n      <input id=\"down\" type=\"number\" value=\"80000\" min=\"0\" step=\"1000\" inputmode=\"decimal\">\n      <label for=\"rate\">Annual interest rate (%)</label>\n      <input id=\"rate\" type=\"number\" value=\"6.5\" min=\"0\" max=\"100\" step=\"0.01\" inputmode=\"decimal\">\n      <label for=\"term\">Term (years)</label>\n      <input id=\"term\" type=\"number\" value=\"30\" min=\"1\" max=\"100\" step=\"1\" inputmode=\"numeric\">\n      <p id=\"error\" role=\"alert\" hidden></p>\n      <small>Principal and interest only. Excludes taxes, insurance, HOA fees and other costs. Calculations use unrounded monthly payments.</small>\n    </article>\n\n    <article aria-labelledby=\"summary-heading\">\n      <h2 id=\"summary-heading\">Your estimate</h2>\n      <p>Monthly payment</p>\n      <h2><output id=\"monthly\">\u2014</output></h2>\n      <dl>\n        <dt>Loan principal</dt>\n        <dd><output id=\"principal\">\u2014</output></dd>\n        <dt>Total interest</dt>\n        <dd><output id=\"interest\">\u2014</output></dd>\n        <dt>Total payment over the term</dt>\n        <dd><output id=\"total\">\u2014</output></dd>\n      </dl>\n      <small>Total payment includes loan principal and interest, not the down payment.</small>\n    </article>\n  </div>\n\n  <article aria-labelledby=\"chart-heading\">\n    <h2 id=\"chart-heading\">Annual payment breakdown</h2>\n    <p><span style=\"color: #087e8b;\">\u25cf Principal</span> &nbsp; <span style=\"color: #a34400;\">\u25cf Interest</span></p>\n    <p><small>Hover over or focus a bar to inspect that year, or choose a year below.</small></p>\n    <svg id=\"chart\" viewBox=\"0 0 900 340\" role=\"group\" aria-label=\"Stacked bar chart of principal and interest paid each year\" style=\"width: 100%; height: auto;\"></svg>\n    <label for=\"year\">Inspect year <output id=\"year-label\">1</output></label>\n    <input id=\"year\" type=\"range\" min=\"1\" max=\"30\" value=\"1\" step=\"1\">\n    <p id=\"year-detail\" aria-live=\"polite\"></p>\n  </article>\n\n  <article aria-labelledby=\"table-heading\">\n    <h2 id=\"table-heading\">Annual amortization schedule</h2>\n    <div style=\"overflow-x: auto;\">\n      <table>\n        <caption>Payments grouped by year</caption>\n        <thead>\n          <tr>\n            <th scope=\"col\">Year</th>\n            <th scope=\"col\">Interest paid</th>\n            <th scope=\"col\">Principal paid</th>\n            <th scope=\"col\">Remaining balance</th>\n          </tr>\n        </thead>\n        <tbody id=\"schedule\"></tbody>\n      </table>\n    </div>\n  </article>\n</section>\n\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  const money = value => value.toLocaleString(\"en-US\", { style: \"currency\", currency: \"USD\" });\n  const ns = \"http://www.w3.org/2000/svg\";\n  let annual = [];\n  function svgNode(tag, attributes, text) {\n    const node = document.createElementNS(ns, tag);\n    for (const [key, value] of Object.entries(attributes)) node.setAttribute(key, value);\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n  function inspect(index) {\n    const row = annual[index];\n    if (!row) return;\n    $(\"year\").value = index + 1;\n    $(\"year-label\").textContent = index + 1;\n    $(\"year-detail\").textContent = `Year ${index + 1}: ${money(row.principal)} principal \u00b7 ${money(row.interest)} interest \u00b7 ${money(row.balance)} remaining`;\n    $(\"chart\").querySelectorAll(\"[data-year]\").forEach(node => {\n      node.setAttribute(\"stroke\", Number(node.dataset.year) === index ? \"currentColor\" : \"none\");\n      node.setAttribute(\"stroke-width\", \"2\");\n    });\n  }\n  function draw() {\n    const chart = $(\"chart\");\n    chart.replaceChildren();\n    const left = 85, top = 20, width = 790, height = 265;\n    const maximum = Math.max(1, ...annual.map(row => row.principal + row.interest));\n    for (let i = 0; i <= 4; i++) {\n      const y = top + height - height * i / 4;\n      chart.append(svgNode(\"line\", { x1: left, x2: left + width, y1: y, y2: y, stroke: \"currentColor\", opacity: \".15\" }));\n      chart.append(svgNode(\"text\", { x: left - 10, y: y + 4, \"text-anchor\": \"end\", fill: \"currentColor\", \"font-size\": \"12\" },\n        (maximum * i / 4).toLocaleString(\"en-US\", { style: \"currency\", currency: \"USD\", maximumFractionDigits: 0 })));\n    }\n    const slot = width / annual.length;\n    annual.forEach((row, index) => {\n      const x = left + slot * index + slot * .12;\n      const w = slot * .76;\n      const principalHeight = row.principal / maximum * height;\n      const interestHeight = row.interest / maximum * height;\n      const group = svgNode(\"g\", {\n        tabindex: \"0\", role: \"img\", \"data-year\": index,\n        \"aria-label\": `Year ${index + 1}: principal ${money(row.principal)}, interest ${money(row.interest)}, remaining balance ${money(row.balance)}`\n      });\n      group.append(svgNode(\"title\", {}, group.getAttribute(\"aria-label\")));\n      group.append(svgNode(\"rect\", { x, y: top + height - principalHeight, width: w, height: principalHeight, fill: \"#087e8b\" }));\n      group.append(svgNode(\"rect\", { x, y: top + height - principalHeight - interestHeight, width: w, height: interestHeight, fill: \"#a34400\" }));\n      group.append(svgNode(\"rect\", { x, y: top, width: w, height, fill: \"transparent\", stroke: \"none\" }));\n      group.addEventListener(\"mouseenter\", () => inspect(index));\n      group.addEventListener(\"focus\", () => inspect(index));\n      group.addEventListener(\"click\", () => inspect(index));\n      chart.append(group);\n      if (index === 0 || index === annual.length - 1 || (index + 1) % Math.max(1, Math.ceil(annual.length / 10)) === 0) {\n        chart.append(svgNode(\"text\", { x: x + w / 2, y: 307, \"text-anchor\": \"middle\", fill: \"currentColor\", \"font-size\": \"12\" }, index + 1));\n      }\n    });\n    chart.append(svgNode(\"text\", { x: left + width / 2, y: 332, \"text-anchor\": \"middle\", fill: \"currentColor\", \"font-size\": \"13\" }, \"Year\"));\n  }\n  function update() {\n    const price = $(\"price\").valueAsNumber;\n    const down = $(\"down\").valueAsNumber;\n    const rate = $(\"rate\").valueAsNumber;\n    const years = $(\"term\").valueAsNumber;\n    const valid = [price, down, rate, years].every(Number.isFinite) &&\n      price >= 0 && price <= 1000000000 && down >= 0 && down <= price &&\n      rate >= 0 && rate <= 100 && Number.isInteger(years) && years >= 1 && years <= 100;\n    $(\"error\").hidden = valid;\n    if (!valid) {\n      $(\"error\").textContent = \"Enter a price from $0 to $1 billion, a down payment no greater than the price, a rate from 0% to 100%, and a whole-number term from 1 to 100 years.\";\n      [\"monthly\", \"principal\", \"interest\", \"total\"].forEach(id => $(id).textContent = \"\u2014\");\n      annual = [];\n      $(\"chart\").replaceChildren();\n      $(\"schedule\").replaceChildren();\n      $(\"year\").disabled = true;\n      $(\"year-label\").textContent = \"\u2014\";\n      $(\"year-detail\").textContent = \"Enter valid loan details to view the schedule.\";\n      return;\n    }\n    const principal = price - down, r = rate / 1200, n = years * 12;\n    const payment = r === 0 ? principal / n : principal * r / (-Math.expm1(-n * Math.log1p(r)));\n    let balance = principal, totalInterest = 0;\n    annual = [];\n    for (let y = 0; y < years; y++) {\n      let interestPaid = 0, principalPaid = 0;\n      for (let m = 0; m < 12; m++) {\n        const interest = balance * r;\n        const paid = y === years - 1 && m === 11 ? balance : Math.min(balance, Math.max(0, payment - interest));\n        interestPaid += interest;\n        principalPaid += paid;\n        balance = Math.max(0, balance - paid);\n      }\n      totalInterest += interestPaid;\n      annual.push({ interest: interestPaid, principal: principalPaid, balance });\n    }\n    $(\"monthly\").textContent = money(payment);\n    $(\"principal\").textContent = money(principal);\n    $(\"interest\").textContent = money(totalInterest);\n    $(\"total\").textContent = money(principal + totalInterest);\n    const fragment = document.createDocumentFragment();\n    annual.forEach((row, i) => {\n      const tr = document.createElement(\"tr\");\n      [i + 1, money(row.interest), money(row.principal), money(row.balance)].forEach((value, column) => {\n        const cell = document.createElement(column === 0 ? \"th\" : \"td\");\n        if (column === 0) cell.scope = \"row\";\n        cell.textContent = value;\n        tr.append(cell);\n      });\n      fragment.append(tr);\n    });\n    $(\"schedule\").replaceChildren(fragment);\n    $(\"year\").disabled = false;\n    $(\"year\").max = years;\n    draw();\n    inspect(Math.min(Number($(\"year\").value) || 1, years) - 1);\n  }\n  [\"price\", \"down\", \"rate\", \"term\"].forEach(id => $(id).addEventListener(\"input\", update));\n  $(\"year\").addEventListener(\"input\", () => inspect(Number($(\"year\").value) - 1));\n  update();\n})();\n</script>",
